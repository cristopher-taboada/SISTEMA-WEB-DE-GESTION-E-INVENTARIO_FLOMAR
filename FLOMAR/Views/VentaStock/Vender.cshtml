@model FLOMAR.Models.VentaStockViewModel

@{
    ViewData["Title"] = "Vender Repuesto";
}

<style>

    .venta-container {
        max-width: 750px;
        margin: 40px auto;
        color: white;
    }

    .venta-card {
        background: #202020;
        border: 1px solid #3d3d3d;
        border-radius: 12px;
        padding: 35px;
    }

    .titulo {
        color: #f4c430;
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .subtitulo {
        color: #aaa;
        margin-bottom: 30px;
    }

    .informacion {
        background: #292929;
        border-left: 5px solid #f4c430;
        padding: 18px;
        border-radius: 6px;
        margin-bottom: 25px;
    }

        .informacion p {
            margin: 7px 0;
        }

        .informacion strong {
            color: #f4c430;
        }

    .campo {
        margin-bottom: 25px;
    }

    .form-label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        background: #151515;
        color: white;
        border: 1px solid #555;
        border-radius: 7px;
        padding: 12px;
    }

        .form-control:focus {
            background: #151515;
            color: white;
            border-color: #f4c430;
            outline: none;
        }

    .text-danger {
        color: #ff6868;
        display: block;
        margin-top: 7px;
    }

    .total {
        background: #151515;
        padding: 18px;
        border-radius: 7px;
        margin-bottom: 25px;
    }

    .btn-confirmar {
        background: #f4c430;
        color: #111;
        border: none;
        padding: 12px 25px;
        border-radius: 7px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-confirmar:hover {
            background: #d9aa00;
        }

    .btn-cancelar {
        display: inline-block;
        background: #333;
        color: white;
        padding: 12px 25px;
        border-radius: 7px;
        text-decoration: none;
        margin-left: 8px;
    }

</style>


<div class="venta-container">

    <h1 class="titulo">
        Vender Repuesto
    </h1>

    <p class="subtitulo">
        Verifica la cantidad antes de confirmar.
    </p>


    <div class="venta-card">


        <div class="informacion">

            <p>
                <strong>Código:</strong>
                @Model.Codigo
            </p>

            <p>
                <strong>Repuesto:</strong>
                @Model.Nombre
            </p>

            <p>
                <strong>Precio:</strong>
                Bs @Model.PrecioVenta.ToString("0.00")
            </p>

            <p>
                <strong>Stock disponible:</strong>
                @Model.StockActual unidades
            </p>

        </div>


        <form asp-controller="VentaStock"
              asp-action="Vender"
              method="post">

            @Html.AntiForgeryToken()


            <input asp-for="IdRepuesto"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <div class="campo">

                <label asp-for="Cantidad"
                       class="form-label">

                    Cantidad a vender

                </label>


                <input asp-for="Cantidad"
                       type="number"
                       min="1"
                       class="form-control" />


                <span asp-validation-for="Cantidad"
                      class="text-danger">
                </span>

            </div>


            <div class="total">

                Precio unitario:

                <strong>
                    Bs @Model.PrecioVenta.ToString("0.00")
                </strong>

            </div>


            <button type="submit"
                    class="btn-confirmar">

                Confirmar venta

            </button>


            <a asp-action="Index"
               class="btn-cancelar">

                Cancelar

            </a>

        </form>

    </div>

</div>