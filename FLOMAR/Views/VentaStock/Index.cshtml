@model IEnumerable<FLOMAR.Models.Repuesto>

@{
    ViewData["Title"] = "Venta de Repuestos";
}

<style>

    .ventas-container {
        max-width: 1200px;
        margin: 35px auto;
        color: white;
    }

    .titulo {
        color: #f4c430;
        font-size: 35px;
        font-weight: bold;
    }

    .subtitulo {
        color: #aaa;
        margin-bottom: 30px;
    }

    .mensaje-exito {
        background: #15351f;
        color: #7cff9d;
        padding: 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

    .mensaje-error {
        background: #451919;
        color: #ff8585;
        padding: 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

    .mensaje-stock {
        background: #493b10;
        color: #ffd95a;
        padding: 15px;
        border-radius: 7px;
        margin-bottom: 20px;
    }

    .tabla-ventas {
        width: 100%;
        background: #202020;
        color: white;
        border-collapse: collapse;
        border-radius: 10px;
        overflow: hidden;
    }

        .tabla-ventas th {
            background: #151515;
            color: #f4c430;
            padding: 15px;
            text-align: left;
        }

        .tabla-ventas td {
            padding: 15px;
            border-bottom: 1px solid #333;
        }

    .stock-normal {
        color: #67db83;
        font-weight: bold;
    }

    .stock-bajo {
        color: #ff6464;
        font-weight: bold;
    }

    .sin-stock {
        color: #ff6464;
        font-weight: bold;
    }

    .btn-vender {
        display: inline-block;
        background: #f4c430;
        color: #111;
        padding: 8px 18px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-vender:hover {
            background: #d9aa00;
            color: #111;
        }

</style>


<div class="ventas-container">

    <h1 class="titulo">
        Venta de Repuestos
    </h1>

    <p class="subtitulo">
        Selecciona el repuesto que deseas vender.
    </p>


    @if (TempData["Exito"] != null)
    {
        <div class="mensaje-exito">
            ✓ @TempData["Exito"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="mensaje-error">
            ⚠ @TempData["Error"]
        </div>
    }


    @if (TempData["StockBajo"] != null)
    {
        <div class="mensaje-stock">
            ⚠ @TempData["StockBajo"]
        </div>
    }


    <table class="tabla-ventas">

        <thead>
            <tr>

                <th>Código</th>

                <th>Repuesto</th>

                <th>Precio</th>

                <th>Stock</th>

                <th>Estado Stock</th>

                <th>Acción</th>

            </tr>
        </thead>


        <tbody>

            @foreach (var repuesto in Model)
            {
                <tr>

                    <td>
                        @repuesto.Codigo
                    </td>


                    <td>
                        @repuesto.Nombre
                    </td>


                    <td>
                        Bs @repuesto.PrecioVenta.ToString("0.00")
                    </td>


                    <td>
                        @repuesto.stock_actual
                    </td>


                    <td>

                        @if (repuesto.stock_actual == 0)
                        {
                            <span class="sin-stock">
                                Sin stock
                            </span>
                        }
                        else if (repuesto.stock_actual <= repuesto.stock_minimo)
                        {
                            <span class="stock-bajo">
                                ⚠ Stock bajo
                            </span>
                        }
                        else
                        {
                            <span class="stock-normal">
                                Stock normal
                            </span>
                        }

                    </td>


                    <td>

                        @if (repuesto.stock_actual > 0)
                        {
                            <a asp-controller="VentaStock"
                               asp-action="Vender"
                               asp-route-id="@repuesto.id_repuesto"
                               class="btn-vender">

                                Vender

                            </a>
                        }
                        else
                        {
                            <span class="sin-stock">
                                No disponible
                            </span>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>