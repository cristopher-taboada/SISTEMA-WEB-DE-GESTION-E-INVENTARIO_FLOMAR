@model IEnumerable<FLOMAR.Models.Repuesto>

@{
    ViewData["Title"] = "Repuestos";
}

<style>
    .repuestos-container {
        padding: 30px;
        color: #f5f5f5;
    }

    .repuestos-titulo {
        color: #f4c430;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .btn-nuevo {
        background-color: #f4c430;
        color: #111;
        border: none;
        font-weight: bold;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-nuevo:hover {
            background-color: #d9aa00;
            color: #111;
        }

    .tabla-repuestos {
        width: 100%;
        margin-top: 25px;
        border-collapse: collapse;
        background-color: #202020;
        color: white;
    }

        .tabla-repuestos th {
            background-color: #111;
            color: #f4c430;
            padding: 12px;
            border-bottom: 2px solid #f4c430;
        }

        .tabla-repuestos td {
            padding: 12px;
            border-bottom: 1px solid #444;
            vertical-align: middle;
        }

        .tabla-repuestos tr:hover {
            background-color: #292929;
        }

    .stock-normal {
        color: #59d879;
        font-weight: bold;
    }

    .stock-bajo {
        color: #ff5252;
        font-weight: bold;
    }

    .estado-activo {
        color: #59d879;
        font-weight: bold;
    }

    .estado-inactivo {
        color: #aaa;
        font-weight: bold;
    }

    .btn-editar {
        background-color: #f4c430;
        color: #111;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin-right: 5px;
    }

    .btn-estado {
        background-color: #444;
        color: white;
        border: 1px solid #666;
        padding: 6px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-editar:hover {
        background-color: #d9aa00;
        color: #111;
    }

    .btn-estado:hover {
        background-color: #555;
    }
</style>

<div class="repuestos-container">

    <div class="d-flex justify-content-between align-items-center">

        <div>
            <h2 class="repuestos-titulo">
                Repuestos
            </h2>

            <p>
                Gestión de repuestos e inventario
            </p>
        </div>

        <a asp-action="Create"
           class="btn-nuevo">
            + Nuevo Repuesto
        </a>

    </div>

    <div class="table-responsive">

        <table class="tabla-repuestos">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Costo</th>
                    <th>Precio</th>
                    <th>Stock Actual</th>
                    <th>Stock Mínimo</th>
                    <th>Alerta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var repuesto in Model)
                {
                    <tr>

                        <td>@repuesto.Codigo</td>

                        <td>@repuesto.Nombre</td>

                        <td>@repuesto.Categoria</td>

                        <td>
                            Bs @repuesto.costo_adquisicion.ToString("N2")
                        </td>

                        <td>
                            Bs @repuesto.PrecioVenta.ToString("N2")
                        </td>

                        <td>
                            @repuesto.stock_actual
                        </td>

                        <td>
                            @repuesto.stock_minimo
                        </td>

                        <td>
                            @if (repuesto.stock_actual <= repuesto.stock_minimo)
                            {
                                <span class="stock-bajo">
                                    ⚠ Stock bajo
                                </span>
                            }
                            else
                            {
                                <span class="stock-normal">
                                    Stock normal
                                </span>
                            }
                        </td>

                        <td>
                            @if (repuesto.id_estado == 1)
                            {
                                <span class="estado-activo">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="estado-inactivo">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@repuesto.id_repuesto"
                               class="btn-editar">
                                Editar
                            </a>

                            <form asp-action="CambiarEstado"
                                  method="post"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="id"
                                       value="@repuesto.id_repuesto" />

                                <button type="submit"
                                        class="btn-estado">

                                    @(repuesto.id_estado == 1
                                        ? "Desactivar"
                                        : "Activar")

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>