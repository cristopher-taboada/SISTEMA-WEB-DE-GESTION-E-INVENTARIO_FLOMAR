@model IEnumerable<FLOMAR.Models.Repuesto>

@{
    ViewData["Title"] = "Repuestos";
}

<style>
    .repuestos-container {
        padding: 30px;
        color: #f5f5f5;
    }

    /* ==============================
           ENCABEZADO
        ============================== */

    .encabezado-repuestos {
        margin-bottom: 25px;
    }

    .repuestos-titulo {
        color: #f4c430;
        font-weight: bold;
        margin: 0 0 5px 0;
    }

    .repuestos-subtitulo {
        color: #f5f5f5;
        margin: 0 0 20px 0;
    }

    .contenedor-boton-nuevo {
        margin-top: 10px;
    }

    .btn-nuevo {
        display: inline-block;
        background-color: #f4c430;
        color: #111;
        border: none;
        font-weight: bold;
        padding: 10px 18px;
        border-radius: 6px;
        text-decoration: none;
    }

        .btn-nuevo:hover {
            background-color: #d9aa00;
            color: #111;
        }


    /* ==============================
           TABLA
        ============================== */

    .tabla-repuestos {
        width: 100%;
        margin-top: 25px;
        border-collapse: collapse;
        background-color: #202020;
        color: white;
    }

        .tabla-repuestos th {
            background-color: #111;
            color: #f4c430;
            padding: 12px;
            border-bottom: 2px solid #f4c430;
            white-space: nowrap;
        }

        .tabla-repuestos td {
            padding: 12px;
            border-bottom: 1px solid #444;
            vertical-align: middle;
        }

        .tabla-repuestos tr:hover {
            background-color: #292929;
        }


    /* ==============================
           STOCK
        ============================== */

    .stock-normal {
        color: #59d879;
        font-weight: bold;
    }

    .stock-bajo {
        color: #ff5252;
        font-weight: bold;
    }

    .stock-agotado {
        color: #ff5252;
        font-weight: bold;
    }


    /* ==============================
           ESTADOS
        ============================== */

    .estado-activo {
        color: #59d879;
        font-weight: bold;
    }

    .estado-inactivo {
        color: #aaa;
        font-weight: bold;
    }


    /* ==============================
           BOTONES
        ============================== */

    .btn-editar {
        display: inline-block;
        background-color: #f4c430;
        color: #111;
        border: none;
        padding: 6px 12px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin-right: 5px;
    }

        .btn-editar:hover {
            background-color: #d9aa00;
            color: #111;
        }

    .btn-estado {
        background-color: #444;
        color: white;
        border: 1px solid #666;
        padding: 6px 12px;
        border-radius: 5px;
        cursor: pointer;
    }

        .btn-estado:hover {
            background-color: #555;
        }


    /* ==============================
           RESPONSIVE
        ============================== */

    @@media (max-width: 768px) {

        .repuestos-container {
            padding: 20px 10px;
        }

        .tabla-repuestos {
            font-size: 14px;
        }

            .tabla-repuestos th,
            .tabla-repuestos td {
                padding: 8px;
            }
    }

</style>


<div class="repuestos-container">

    <!-- ENCABEZADO -->

    <div class="encabezado-repuestos">

        <div>
            <h2 class="repuestos-titulo">
                Repuestos
            </h2>

            <p class="repuestos-subtitulo">
                Gestión de repuestos e inventario
            </p>
        </div>


        <div class="contenedor-boton-nuevo">

            <a asp-action="Create"
               class="btn-nuevo">
                + Nuevo Repuesto
            </a>

        </div>

    </div>


    <!-- TABLA -->

    <div class="table-responsive">

        <table class="tabla-repuestos">

            <thead>

                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Costo</th>
                    <th>Precio</th>
                    <th>Stock Actual</th>
                    <th>Stock Mínimo</th>
                    <th>Alerta</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>

            </thead>


            <tbody>

                @foreach (var repuesto in Model)
                {
                    <tr>

                        <!-- CÓDIGO -->

                        <td>
                            @repuesto.Codigo
                        </td>


                        <!-- NOMBRE -->

                        <td>
                            @repuesto.Nombre
                        </td>


                        <!-- CATEGORÍA -->

                        <td>
                            @repuesto.Categoria
                        </td>


                        <!-- COSTO -->

                        <td>
                            Bs @repuesto.costo_adquisicion.ToString("N2")
                        </td>


                        <!-- PRECIO -->

                        <td>
                            Bs @repuesto.PrecioVenta.ToString("N2")
                        </td>


                        <!-- STOCK ACTUAL -->

                        <td>

                            @if (repuesto.stock_actual == 0)
                            {
                                <span class="stock-agotado">
                                    @repuesto.stock_actual
                                </span>
                            }
                            else if (repuesto.stock_actual <= repuesto.stock_minimo)
                            {
                                <span class="stock-bajo">
                                    @repuesto.stock_actual
                                </span>
                            }
                            else
                            {
                                <span class="stock-normal">
                                    @repuesto.stock_actual
                                </span>
                            }

                        </td>


                        <!-- STOCK MÍNIMO -->

                        <td>
                            @repuesto.stock_minimo
                        </td>


                        <!-- VALIDACIÓN DE STOCK -->

                        <td>

                            @if (repuesto.stock_actual == 0)
                            {
                                <span class="stock-agotado">
                                    ⚠ AGOTADO
                                </span>
                            }
                            else if (repuesto.stock_actual <= repuesto.stock_minimo)
                            {
                                <span class="stock-bajo">
                                    ⚠ Stock bajo
                                </span>
                            }
                            else
                            {
                                <span class="stock-normal">
                                    Stock normal
                                </span>
                            }

                        </td>


                        <!-- ESTADO -->

                        <td>

                            @if (repuesto.id_estado == 1)
                            {
                                <span class="estado-activo">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="estado-inactivo">
                                    Inactivo
                                </span>
                            }

                        </td>


                        <!-- ACCIONES -->

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@repuesto.id_repuesto"
                               class="btn-editar">
                                Editar
                            </a>


                            <form asp-action="CambiarEstado"
                                  method="post"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="id"
                                       value="@repuesto.id_repuesto" />


                                <button type="submit"
                                        class="btn-estado">

                                    @(repuesto.id_estado == 1
                                        ? "Desactivar"
                                        : "Activar")

                                </button>

                            </form>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>