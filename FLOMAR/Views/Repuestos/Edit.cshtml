@model FLOMAR.Models.Repuesto

@{
    ViewData["Title"] = "Editar Repuesto";
}

<style>
    .editar-page {
        min-height: 100vh;
        background: #181818;
        padding: 35px;
        color: white;
    }

    .editar-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .editar-header {
        margin-bottom: 25px;
    }

        .editar-header h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            font-weight: bold;
        }

            .editar-header h1 span {
                color: #d4af37;
            }

        .editar-header p {
            color: #aaa;
            margin: 0;
        }

    .editar-card {
        background: #202020;
        border: 1px solid #3b3b3b;
        border-radius: 10px;
        padding: 30px;
    }

    .editar-info {
        background: #292929;
        border-left: 4px solid #d4af37;
        padding: 13px 15px;
        border-radius: 4px;
        margin-bottom: 25px;
        color: #bbb;
    }

        .editar-info strong {
            color: #d4af37;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #eee;
        }

    .form-control-flomar {
        width: 100%;
        background: #181818;
        color: white;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 12px 14px;
        box-sizing: border-box;
        outline: none;
    }

        .form-control-flomar:focus {
            border-color: #d4af37;
        }

    .validation-message {
        display: block;
        color: #ff6565;
        font-size: 13px;
        margin-top: 5px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-guardar {
        background: #d4af37;
        color: #111;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background: #e5c34b;
        }

    .btn-cancelar {
        background: transparent;
        color: #ddd;
        border: 1px solid #555;
        padding: 11px 24px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-cancelar:hover {
            color: #d4af37;
            border-color: #d4af37;
        }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="editar-page">

    <div class="editar-container">

        <div class="editar-header">

            <h1>
                Editar <span>Repuesto</span>
            </h1>

            <p>
                Modifica la información del repuesto seleccionado.
            </p>

        </div>


        <div class="editar-card">

            <div class="editar-info">
                Editando repuesto:
                <strong>#@Model.Id - @Model.Codigo</strong>
            </div>


            <form asp-controller="Repuestos"
                  asp-action="Edit"
                  method="post">

                <!-- ID OCULTO -->
                <input type="hidden"
                       asp-for="Id" />


                <!-- CÓDIGO Y NOMBRE -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Codigo">
                            Código
                        </label>

                        <input asp-for="Codigo"
                               class="form-control-flomar" />

                        <span asp-validation-for="Codigo"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Nombre">
                            Nombre del repuesto
                        </label>

                        <input asp-for="Nombre"
                               class="form-control-flomar" />

                        <span asp-validation-for="Nombre"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- CATEGORÍA -->
                <div class="form-group">

                    <label asp-for="Categoria">
                        Categoría
                    </label>

                    <input asp-for="Categoria"
                           class="form-control-flomar" />

                    <span asp-validation-for="Categoria"
                          class="validation-message">
                    </span>

                </div>


                <!-- COSTO Y PRECIO -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Costo">
                            Costo / Precio de compra (Bs)
                        </label>

                        <input asp-for="Costo"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control-flomar" />

                        <span asp-validation-for="Costo"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="PrecioVenta">
                            Precio de venta (Bs)
                        </label>

                        <input asp-for="PrecioVenta"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control-flomar" />

                        <span asp-validation-for="PrecioVenta"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- STOCK -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Stock">
                            Stock Actual
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               min="0"
                               class="form-control-flomar" />

                        <span asp-validation-for="Stock"
                              class="validation-message">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="StockMinimo">
                            Stock Mínimo
                        </label>

                        <input asp-for="StockMinimo"
                               type="number"
                               min="0"
                               class="form-control-flomar" />

                        <span asp-validation-for="StockMinimo"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- BOTONES -->
                <div class="form-actions">

                    <button type="submit"
                            class="btn-guardar">
                        Guardar cambios
                    </button>


                    <a asp-controller="Repuestos"
                       asp-action="Index"
                       class="btn-cancelar">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>