@model FLOMAR.Models.Repuesto

@{
    ViewData["Title"] = "Editar Repuesto";
}

<style>
    .edit-container {
        max-width: 1050px;
        margin: 35px auto;
        color: white;
    }

    .edit-titulo {
        color: #f4c430;
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .edit-subtitulo {
        color: #bdbdbd;
        font-size: 18px;
        margin-bottom: 30px;
    }

    .edit-card {
        background-color: #202020;
        border: 1px solid #444;
        border-radius: 12px;
        padding: 38px;
    }

    .edit-info {
        background-color: #292929;
        border-left: 5px solid #f4c430;
        padding: 16px 20px;
        margin-bottom: 30px;
        border-radius: 5px;
        color: #ccc;
    }

        .edit-info strong {
            color: #f4c430;
        }

    .campo {
        margin-bottom: 25px;
    }

    .form-label {
        color: white;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        width: 100%;
        background-color: #181818;
        color: white;
        border: 1px solid #555;
        border-radius: 7px;
        padding: 12px 16px;
    }

        .form-control:focus,
        .form-select:focus {
            background-color: #181818;
            color: white;
            border-color: #f4c430;
            box-shadow: 0 0 0 2px rgba(244, 196, 48, 0.15);
        }

        .form-select option {
            background-color: #181818;
            color: white;
        }

    .botones {
        margin-top: 15px;
        padding-top: 20px;
        border-top: 1px solid #444;
    }

    .btn-guardar {
        background-color: #f4c430;
        color: #111;
        border: none;
        border-radius: 7px;
        padding: 12px 28px;
        font-weight: bold;
    }

        .btn-guardar:hover {
            background-color: #d9aa00;
        }

    .btn-cancelar {
        display: inline-block;
        background-color: #292929;
        color: white;
        border: 1px solid #555;
        border-radius: 7px;
        padding: 11px 28px;
        margin-left: 8px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-cancelar:hover {
            background-color: #3b3b3b;
            color: white;
        }

    .text-danger {
        display: block;
        margin-top: 5px;
    }
</style>


<div class="edit-container">

    <h1 class="edit-titulo">
        Editar Repuesto
    </h1>

    <p class="edit-subtitulo">
        Modifica la información del repuesto seleccionado.
    </p>


    <div class="edit-card">

        <div class="edit-info">
            Editando repuesto:
            <strong>
                #@Model.id_repuesto - @Model.Codigo
            </strong>
        </div>


        <form asp-controller="Repuestos"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <!-- IMPORTANTE: envía el ID al controlador -->
            <input asp-for="id_repuesto"
                   type="hidden" />


            <div class="row">

                <div class="col-md-6 campo">

                    <label asp-for="Codigo"
                           class="form-label">
                        Código
                    </label>

                    <input asp-for="Codigo"
                           class="form-control" />

                    <span asp-validation-for="Codigo"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 campo">

                    <label asp-for="Nombre"
                           class="form-label">
                        Nombre del repuesto
                    </label>

                    <input asp-for="Nombre"
                           class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-12 campo">

                    <label asp-for="id_categoria"
                           class="form-label">
                        Categoría
                    </label>

                    <select asp-for="id_categoria"
                            class="form-select">

                        <option value="1">Frenos</option>
                        <option value="2">Suspensión</option>
                        <option value="3">Motor</option>
                        <option value="4">Eléctrico</option>
                        <option value="5">Aceites</option>

                    </select>

                    <span asp-validation-for="id_categoria"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 campo">

                    <label asp-for="costo_adquisicion"
                           class="form-label">
                        Costo / Precio de compra (Bs)
                    </label>

                    <input asp-for="costo_adquisicion"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="costo_adquisicion"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 campo">

                    <label asp-for="PrecioVenta"
                           class="form-label">
                        Precio de venta (Bs)
                    </label>

                    <input asp-for="PrecioVenta"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="PrecioVenta"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 campo">

                    <label asp-for="stock_actual"
                           class="form-label">
                        Stock Actual
                    </label>

                    <input asp-for="stock_actual"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="stock_actual"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 campo">

                    <label asp-for="stock_minimo"
                           class="form-label">
                        Stock Mínimo
                    </label>

                    <input asp-for="stock_minimo"
                           type="number"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="stock_minimo"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>


            <div class="botones">

                <button type="submit"
                        class="btn-guardar">
                    Guardar cambios
                </button>

                <a asp-action="Index"
                   class="btn-cancelar">
                    Cancelar
                </a>

            </div>

        </form>

    </div>

</div>