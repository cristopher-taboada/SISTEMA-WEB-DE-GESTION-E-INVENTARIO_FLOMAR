@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null; 
}
<style>
    .login-pagina {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: #1a1a1a;
        color: white;
        font-family: Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        width: 350px;
        background-color: #2b2b2b;
        padding: 35px;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.5);
    }

    .logo {
        text-align: center;
        color: #d4af37;
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .titulo {
        text-align: center;
        color: #d4af37;
        margin-bottom: 20px; 
    }

    /* aqui estoy agregando un estilo para el mensaje de error osea cunado no entre le de error creo que es bueno visualmente  */
    .error-mensaje {
        background-color: #ff4c4c;
        color: white;
        padding: 10px;
        border-radius: 5px;
        text-align: center;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .campo {
        margin-bottom: 20px;
    }

    .campo label {
        display: block;
        margin-bottom: 8px;
        color: white;
        font-weight: bold;
    }

    .campo input {
        width: 100%;
        padding: 12px;
        box-sizing: border-box;
        border: 1px solid #555;
        border-radius: 5px;
        background-color: #1a1a1a;
        color: white;
        font-size: 15px;
    }

    .campo input:focus {
        outline: none;
        border-color: #d4af37;
    }

    .boton {
        width: 100%;
        padding: 12px;
        background-color: #d4af37;
        color: #1a1a1a;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .boton:hover {
        background-color: #e6c65c;
    }
</style>

<div class="login-pagina">
    <div class="login-card">
        <div class="logo">
            FLOMAR
        </div>
        <h2 class="titulo">
            Iniciar sesión
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="error-mensaje">
                @ViewBag.Error
            </div>
        }
        
        <form asp-controller="Login" asp-action="Entrar" method="post">
            <div class="campo">
                <label>Usuario</label>
                <input type="text" name="usuario_input" placeholder="Ingrese su usuario" required>
            </div>

            <div class="campo">
                <label>Contraseña</label>
                <input type="password" name="password_input" placeholder="Ingrese su contraseña" required>
            </div>
           
            <button type="submit" class="boton">
                Ingresar
            </button>
        </form>
    </div>
</div>