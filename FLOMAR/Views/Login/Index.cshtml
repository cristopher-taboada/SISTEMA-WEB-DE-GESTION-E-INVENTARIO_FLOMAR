@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

<form method="post">

    <div>
        <label>Usuario</label>
        <br />
        <input type="text" name="usuario" />
    </div>

    <br />

    <div>
        <label>Contraseña</label>
        <br />
        <input type="password" name="contrasena" />
    </div>

    <br />

    <button type="submit">Ingresar</button>

</form>