@model FLOMAR.Models.VentaDetalleViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Comprobante de Venta - FLOMAR</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Rajdhani', 'Segoe UI', sans-serif;
            background-color: #1e1f22;
            color: #e0e0e0;
            min-height: 100vh;
        }
        header {
            background-color: #25262b;
            padding: 14px 30px;
            display: flex;
            align-items: center;
            gap: 15px;
            border-bottom: 3px solid #ff5722;
        }
        .logo-flomar {
            width: 40px; height: 40px;
            background-color: #ff5722;
            color: #fff;
            font-weight: 700; font-size: 22px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 6px;
        }
        header span { font-size: 20px; font-weight: 700; letter-spacing: 2px; }
        .container { max-width: 700px; margin: 35px auto; padding: 0 20px; }
        .exito {
            background-color: #1d3320;
            border: 1px solid #4caf50;
            color: #7bd97b;
            border-radius: 8px;
            padding: 12px 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .card {
            background-color: #2b2d31;
            border: 1px solid #3f4147;
            border-radius: 10px;
            padding: 25px 30px;
        }
        .numero { color: #ff5722; font-size: 26px; font-weight: 700; }
        .meta { color: #aaa; font-size: 14px; margin-top: 4px; }
        .meta b { color: #e0e0e0; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th {
            text-align: left;
            color: #ff5722;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 8px 6px;
            border-bottom: 2px solid #3f4147;
        }
        td { padding: 10px 6px; border-bottom: 1px solid #3f4147; font-size: 15px; }
        td.num, th.num { text-align: right; }
        .totales { margin-top: 18px; text-align: right; }
        .totales div { display: flex; justify-content: flex-end; gap: 40px; padding: 4px 6px; color: #aaa; }
        .totales .total-final {
            color: #fff; font-size: 22px; font-weight: 700;
            border-top: 2px solid #ff5722; margin-top: 6px; padding-top: 10px;
        }
        .acciones { margin-top: 25px; display: flex; gap: 12px; }
        .btn-volver {
            background-color: #ff5722;
            color: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            padding: 12px 22px;
            border-radius: 6px;
        }
        .btn-volver:hover { background-color: #e64a19; }
    </style>
</head>
<body>

    <header>
        <div class="logo-flomar">F</div>
        <span>Comprobante de venta</span>
    </header>

    <div class="container">
        <div class="exito">&#10004; Venta registrada correctamente. El stock ya fue descontado del inventario.</div>

        <div class="card">
            <div class="numero">@Model!.numero_transaccion</div>
            <div class="meta">
                <b>Fecha:</b> @Model.fecha_hora.ToString("dd/MM/yyyy HH:mm") &nbsp;|&nbsp;
                <b>Vendedor:</b> @Model.vendedor &nbsp;|&nbsp;
                <b>M&eacute;todo de pago:</b> @Model.metodo_pago &nbsp;|&nbsp;
                <b>Comprobante:</b> @Model.tipo_comprobante
            </div>

            <table>
                <thead>
                    <tr>
                        <th>C&oacute;digo</th>
                        <th>Repuesto</th>
                        <th class="num">Cant.</th>
                        <th class="num">P. Unit.</th>
                        <th class="num">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.detalles)
                    {
                        <tr>
                            <td>@item.codigo</td>
                            <td>@item.nombre</td>
                            <td class="num">@item.cantidad</td>
                            <td class="num">Bs. @item.precio_unitario.ToString("N2")</td>
                            <td class="num">Bs. @item.subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="totales">
                <div><span>Subtotal:</span><span>Bs. @Model.subtotal.ToString("N2")</span></div>
                <div><span>IVA (13%):</span><span>Bs. @Model.monto_impuesto.ToString("N2")</span></div>
                <div class="total-final"><span>TOTAL:</span><span>Bs. @Model.total_venta.ToString("N2")</span></div>
            </div>

            <div class="acciones">
                <a class="btn-volver" href="@Url.Action("Vendedor", "Home")">&larr; Volver al punto de venta</a>
            </div>
        </div>
    </div>

</body>
</html>
