@model FLOMAR.Models.MovimientoIndexViewModel

@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<style>
    .compras-page {
        min-height: 100vh;
        background: #181818;
        padding: 35px;
        color: white;
    }

    .compras-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .compras-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }

            .compras-header h1 span {
                color: #d4af37;
            }

        .compras-header p {
            margin: 7px 0 0;
            color: #aaa;
        }

    .btn-nuevo {
        background: #d4af37;
        color: #111;
        padding: 12px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-nuevo:hover {
            background: #e5c34b;
            color: #111;
        }

    .compras-card {
        background: #202020;
        border: 1px solid #3b3b3b;
        border-radius: 10px;
        padding: 20px;
        overflow-x: auto;
    }

    .compras-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
    }

        .compras-table th {
            color: #d4af37;
            text-align: left;
            padding: 15px 12px;
            border-bottom: 2px solid #444;
            font-size: 14px;
        }

        .compras-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #333;
            color: #eee;
        }

        .compras-table tbody tr:hover {
            background: #292929;
        }

    .codigo-compra {
        color: #bbb;
        font-weight: bold;
    }

    .acciones {
        white-space: nowrap;
    }

    .btn-ver {
        display: inline-block;
        background: transparent;
        color: #d4af37;
        border: 1px solid #d4af37;
        padding: 6px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin-right: 5px;
    }

        .btn-ver:hover {
            background: #d4af37;
            color: #111;
        }

    .btn-desactivar {
        background: transparent;
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
        padding: 6px 10px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-desactivar:hover {
            background: #ff6b6b;
            color: #111;
        }

    .badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
    }

    .badge-suma {
        background: rgba(40, 167, 69, 0.2);
        color: #51cf66;
    }

    .badge-resta {
        background: rgba(220, 53, 69, 0.2);
        color: #ff6b6b;
    }

    .precio {
        white-space: nowrap;
    }

    .sin-compras {
        text-align: center;
        padding: 30px !important;
        color: #999 !important;
    }

    .alerta {
        padding: 13px 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .alerta-error {
        background: rgba(220, 53, 69, 0.15);
        border: 1px solid #ff6b6b;
        color: #ff6b6b;
    }

    .alerta-exito {
        background: rgba(40, 167, 69, 0.15);
        border: 1px solid #63d471;
        color: #63d471;
    }

    /* ============================================================ */
    /* ALERTA DE PRODUCTOS SIN MOVIMIENTO (INMOVILIZADOS)           */
    /* ============================================================ */
    .alerta-inmovilizado {
        background: rgba(212, 175, 55, 0.08);
        border: 1px solid #d4af37;
        border-left: 5px solid #d4af37;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .alerta-cabecera {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .alerta-inmovilizado h3 {
        margin: 0 0 6px 0;
        color: #d4af37;
        font-size: 19px;
    }

    .alerta-inmovilizado p {
        margin: 0;
        color: #bbb;
        font-size: 14px;
        max-width: 640px;
    }

    .filtro-meses {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #aaa;
        font-size: 13px;
    }

        .filtro-meses label {
            text-transform: uppercase;
            font-weight: bold;
            color: #d4af37;
        }

        .filtro-meses input {
            width: 70px;
            background: #181818;
            border: 1px solid #555;
            color: #eee;
            border-radius: 5px;
            padding: 7px 8px;
            font-weight: bold;
        }

    .btn-aplicar {
        background: transparent;
        color: #d4af37;
        border: 1px solid #d4af37;
        padding: 7px 14px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-aplicar:hover {
            background: #d4af37;
            color: #111;
        }

    .alerta-tabla-contenedor {
        background: #202020;
        border: 1px solid #3b3b3b;
        border-radius: 8px;
        overflow-x: auto;
    }

    .alerta-tabla {
        min-width: 950px;
        width: 100%;
        border-collapse: collapse;
    }

    .badge-ambar {
        background: rgba(212, 175, 55, 0.2);
        color: #e5c34b;
    }

    .badge-nunca {
        background: rgba(220, 53, 69, 0.2);
        color: #ff6b6b;
    }

    .badge-venta {
        background: rgba(66, 135, 245, 0.2);
        color: #7fb2ff;
    }

    .alerta-total {
        margin-top: 15px;
        text-align: right;
        color: #bbb;
        font-size: 14px;
    }

        .alerta-total strong {
            color: #d4af37;
            font-size: 16px;
        }
</style>


<div class="compras-page">

    <!-- ENCABEZADO -->
    <div class="compras-header">

        <div>
            <h1>
                Movimiento <span>Inventario</span>
            </h1>

            <p>
                Movimientos de ajustes, ingresos y mermas de mercaderia de FLOMAR.
            </p>
        </div>

        <a asp-controller="MovimientoInventario"
           asp-action="Create"
           class="btn-nuevo">

            + Nuevo Movimiento

        </a>

    </div>


    <!-- MENSAJES DE EXITO / ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alerta alerta-error">@TempData["Error"]</div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alerta alerta-exito">@TempData["Exito"]</div>
    }


    <!-- ================================================================ -->
    <!-- ALERTA: REPUESTOS SIN MOVIMIENTO EN LOS ULTIMOS N MESES          -->
    <!-- ================================================================ -->
    @if (Model.SinMovimiento.Any())
    {
        <div class="alerta-inmovilizado">

            <div class="alerta-cabecera">

                <div>
                    <h3>&#9888; Alerta: productos sin movimiento</h3>
                    <p>
                        @Model.SinMovimiento.Count repuesto(s) no registran ingresos, salidas, ajustes ni mermas
                        desde hace mas de @Model.MesesSinMovimiento mes(es).
                        Revisa si conviene promocionarlos, rematarlos o darles de baja.
                    </p>
                </div>

                <form asp-controller="MovimientoInventario"
                      asp-action="Index"
                      method="get"
                      class="filtro-meses">

                    <label for="meses">Antiguedad</label>

                    <input type="number"
                           id="meses"
                           name="meses"
                           min="1"
                           max="120"
                           value="@Model.MesesSinMovimiento" />

                    <span>meses</span>

                    <button type="submit" class="btn-aplicar">Aplicar</button>

                </form>

            </div>

            <div class="alerta-tabla-contenedor">

                <table class="alerta-tabla compras-table">

                    <thead>
                        <tr>
                            <th>Codigo</th>
                            <th>Repuesto</th>
                            <th>Stock</th>
                            <th>Ultimo movimiento</th>
                            <th>Sin movimiento</th>
                            <th>Valor inmovilizado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var d in Model.SinMovimiento)
                        {
                            <tr>

                                <td class="codigo-compra">@d.codigo</td>

                                <td>
                                    <strong>@d.nombre</strong>
                                </td>

                                <td>
                                    @d.stock_actual
                                    @if (d.stock_actual <= d.stock_minimo)
                                    {
                                        <span class="badge badge-resta">Bajo minimo</span>
                                    }
                                </td>

                                <td>
                                    @if (d.ultimo_movimiento.HasValue)
                                    {
                                        @d.ultimo_movimiento.Value.ToString("dd/MM/yyyy")

                                        @if (d.origen_ultimo_movimiento == "Venta")
                                        {
                                            <span class="badge badge-venta">Venta</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-ambar">Kardex</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-nunca">Nunca movido</span>
                                    }
                                </td>

                                <td class="precio">
                                    @if (d.dias_sin_movimiento.HasValue)
                                    {
                                        <span class="badge badge-ambar">@d.dias_sin_movimiento dias</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-nunca">Sin registro</span>
                                    }
                                </td>

                                <td class="precio">Bs @d.valor_inmovilizado.ToString("0.00")</td>

                                <td class="acciones">

                                    <a asp-controller="MovimientoInventario"
                                       asp-action="Create"
                                       asp-route-id_repuesto="@d.id_repuesto"
                                       class="btn-ver">

                                        Registrar movimiento

                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

            <div class="alerta-total">
                Dinero inmovilizado en estos productos:
                <strong>Bs @Model.SinMovimiento.Sum(d => d.valor_inmovilizado).ToString("0.00")</strong>
            </div>

        </div>
    }
    else
    {
        <div class="alerta alerta-exito">
            Ningun repuesto lleva mas de @Model.MesesSinMovimiento mes(es) sin movimiento de inventario.
        </div>
    }


    <!-- TARJETA -->
    <div class="compras-card">

        <table class="compras-table">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Codigo</th>
                    <th>Repuesto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Motivo</th>
                    <th>Usuario</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Movimientos.Any())
                {
                    @foreach (var m in Model.Movimientos)
                    {
                        <tr>

                            <!-- FECHA -->
                            <td>
                                @m.fecha_movimiento.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <!-- CODIGO -->
                            <td class="codigo-compra">
                                @m.codigo_repuesto
                            </td>

                            <!-- REPUESTO -->
                            <td>
                                <strong>@m.nombre_repuesto</strong>
                            </td>

                            <!-- TIPO -->
                            <td>
                                @if (m.signo == 1)
                                {
                                    <span class="badge badge-suma">@m.tipo_movimiento (+)</span>
                                }
                                else
                                {
                                    <span class="badge badge-resta">@m.tipo_movimiento (-)</span>
                                }
                            </td>

                            <!-- CANTIDAD -->
                            <td>
                                @m.cantidad
                            </td>

                            <!-- MOTIVO -->
                            <td>
                                @m.motivo
                            </td>

                            <!-- USUARIO -->
                            <td>
                                @m.usuario
                            </td>

                            <!-- STOCK -->
                            <td class="precio" style="color:#d4af37; font-weight:bold;">
                                @m.stock_resultante
                            </td>

                            <!-- ACCIONES -->
                            <td class="acciones">

                                <a asp-controller="MovimientoInventario"
                                   asp-action="Details"
                                   asp-route-id="@m.id_movimiento"
                                   class="btn-ver">

                                    Ver

                                </a>

                                <form asp-controller="MovimientoInventario"
                                      asp-action="Delete"
                                      asp-route-id="@m.id_movimiento"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn-desactivar"
                                            onclick="return confirm('Esta seguro? Se revertira el stock.')">

                                        Eliminar

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            class="sin-compras">

                            No existen movimientos registrados.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
