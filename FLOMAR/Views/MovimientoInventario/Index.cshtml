@model IEnumerable<FLOMAR.Models.MovimientoListaViewModel>

@{
    ViewData["Title"] = "Movimientos de Inventario";
}

<style>
    .compras-page {
        min-height: 100vh;
        background: #181818;
        padding: 35px;
        color: white;
    }

    .compras-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .compras-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: bold;
        }

            .compras-header h1 span {
                color: #d4af37;
            }

        .compras-header p {
            margin: 7px 0 0;
            color: #aaa;
        }

    .btn-nuevo {
        background: #d4af37;
        color: #111;
        padding: 12px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-nuevo:hover {
            background: #e5c34b;
            color: #111;
        }

    .compras-card {
        background: #202020;
        border: 1px solid #3b3b3b;
        border-radius: 10px;
        padding: 20px;
        overflow-x: auto;
    }

    .compras-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
    }

        .compras-table th {
            color: #d4af37;
            text-align: left;
            padding: 15px 12px;
            border-bottom: 2px solid #444;
            font-size: 14px;
        }

        .compras-table td {
            padding: 15px 12px;
            border-bottom: 1px solid #333;
            color: #eee;
        }

        .compras-table tbody tr:hover {
            background: #292929;
        }

    .codigo-compra {
        color: #bbb;
        font-weight: bold;
    }

    .acciones {
        white-space: nowrap;
    }

    .btn-ver {
        display: inline-block;
        background: transparent;
        color: #d4af37;
        border: 1px solid #d4af37;
        padding: 6px 10px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        margin-right: 5px;
    }

        .btn-ver:hover {
            background: #d4af37;
            color: #111;
        }

    .btn-desactivar {
        background: transparent;
        color: #ff6b6b;
        border: 1px solid #ff6b6b;
        padding: 6px 10px;
        border-radius: 5px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-desactivar:hover {
            background: #ff6b6b;
            color: #111;
        }

    .badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: bold;
    }

    .badge-suma {
        background: rgba(40, 167, 69, 0.2);
        color: #51cf66;
    }

    .badge-resta {
        background: rgba(220, 53, 69, 0.2);
        color: #ff6b6b;
    }

    .precio {
        white-space: nowrap;
    }

    .sin-compras {
        text-align: center;
        padding: 30px !important;
        color: #999 !important;
    }

    .alerta {
        padding: 13px 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-weight: bold;
    }

    .alerta-error {
        background: rgba(220, 53, 69, 0.15);
        border: 1px solid #ff6b6b;
        color: #ff6b6b;
    }

    .alerta-exito {
        background: rgba(40, 167, 69, 0.15);
        border: 1px solid #63d471;
        color: #63d471;
    }
</style>


<div class="compras-page">

    <!-- ENCABEZADO -->
    <div class="compras-header">

        <div>
            <h1>
                Administrar <span>Inventario</span>
            </h1>

            <p>
                Movimientos de ajustes, ingresos y mermas de mercaderia de FLOMAR.
            </p>
        </div>

        <a asp-controller="MovimientoInventario"
           asp-action="Create"
           class="btn-nuevo">

            + Nuevo Movimiento

        </a>

    </div>


    <!-- MENSAJES DE EXITO / ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alerta alerta-error">@TempData["Error"]</div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alerta alerta-exito">@TempData["Exito"]</div>
    }


    <!-- TARJETA -->
    <div class="compras-card">

        <table class="compras-table">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Codigo</th>
                    <th>Repuesto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Motivo</th>
                    <th>Usuario</th>
                    <th>Stock</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var m in Model)
                    {
                        <tr>

                            <!-- FECHA -->
                            <td>
                                @m.fecha_movimiento.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <!-- CODIGO -->
                            <td class="codigo-compra">
                                @m.codigo_repuesto
                            </td>

                            <!-- REPUESTO -->
                            <td>
                                <strong>@m.nombre_repuesto</strong>
                            </td>

                            <!-- TIPO -->
                            <td>
                                @if (m.signo == 1)
                                {
                                    <span class="badge badge-suma">@m.tipo_movimiento (+)</span>
                                }
                                else
                                {
                                    <span class="badge badge-resta">@m.tipo_movimiento (-)</span>
                                }
                            </td>

                            <!-- CANTIDAD -->
                            <td>
                                @m.cantidad
                            </td>

                            <!-- MOTIVO -->
                            <td>
                                @m.motivo
                            </td>

                            <!-- USUARIO -->
                            <td>
                                @m.usuario
                            </td>

                            <!-- STOCK -->
                            <td class="precio" style="color:#d4af37; font-weight:bold;">
                                @m.stock_resultante
                            </td>

                            <!-- ACCIONES -->
                            <td class="acciones">

                                <a asp-controller="MovimientoInventario"
                                   asp-action="Details"
                                   asp-route-id="@m.id_movimiento"
                                   class="btn-ver">

                                    Ver

                                </a>

                                <form asp-controller="MovimientoInventario"
                                      asp-action="Delete"
                                      asp-route-id="@m.id_movimiento"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn-desactivar"
                                            onclick="return confirm('Esta seguro? Se revertira el stock.')">

                                        Eliminar

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            class="sin-compras">

                            No existen movimientos registrados.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
