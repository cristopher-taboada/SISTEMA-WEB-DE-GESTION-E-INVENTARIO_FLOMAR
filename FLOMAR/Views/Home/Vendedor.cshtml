
@{
    Layout = null;
    ViewData["Title"] = "Vendedor - FLOMAR";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>FLOMAR - Panel de Vendedor</title>

    <style>

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
            }

            body {
                background-color: #1a1a1a;
                color: white;
                font-family: Arial, sans-serif;
            }


            /* ENCABEZADO */

            .encabezado {
                height: 65px;
                background-color: #222222;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                border-bottom: 1px solid #444444;
            }


            .logo {
                color: #d4af37;
                font-size: 25px;
                font-weight: bold;
            }


            .usuario {
                color: #cccccc;
                margin-right: 20px;
            }


            .cerrar {
                background-color: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                border-radius: 5px;
                padding: 8px 15px;
                cursor: pointer;
            }


                .cerrar:hover {
                    background-color: #d4af37;
                    color: #1a1a1a;
                }



            /* CONTENIDO */

            .contenido {
                height: calc(100vh - 65px);
                padding: 25px 30px;
            }


            .titulo {
                margin: 0 0 20px 0;
                color: white;
                font-size: 24px;
            }


                .titulo span {
                    color: #d4af37;
                }



            /* ZONA PRINCIPAL */

            .zona {
                height: calc(100% - 55px);
                display: grid;
                grid-template-columns: 1fr 380px;
                gap: 20px;
            }



            /* PRODUCTOS */

            .productos {
                background-color: #222222;
                border: 1px solid #444444;
                border-radius: 8px;
                padding: 20px;
                overflow: hidden;
            }



            /* BUSQUEDA */

            .busqueda {
                display: flex;
                gap: 10px;
                margin-bottom: 20px;
            }


                .busqueda input {
                    flex: 1;
                    background-color: #1a1a1a;
                    border: 1px solid #555555;
                    border-radius: 5px;
                    padding: 13px;
                    color: white;
                    font-size: 15px;
                }


                    .busqueda input:focus {
                        outline: none;
                        border-color: #d4af37;
                    }


            .buscar {
                background-color: #d4af37;
                border: none;
                border-radius: 5px;
                padding: 0 20px;
                font-weight: bold;
                cursor: pointer;
            }



            /* CATEGORIAS */

            .categorias {
                display: flex;
                gap: 8px;
                margin-bottom: 18px;
            }


            .categoria {
                background-color: #2b2b2b;
                color: #cccccc;
                border: 1px solid #444444;
                border-radius: 5px;
                padding: 7px 13px;
                cursor: pointer;
            }


                .categoria.activa {
                    background-color: #d4af37;
                    color: #1a1a1a;
                    font-weight: bold;
                }



            /* LISTA DE PRODUCTOS */

            .lista-productos {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
                padding-left: 10%;
                padding-right: 10%;
            }



            /* TARJETAS */

            .producto {
                background-color: #2b2b2b;
                border: 1px solid #444444;
                border-radius: 7px;
                padding: 15px;
            }


                .producto:hover {
                    border-color: #d4af37;
                }


                .producto h3 {
                    color: #d4af37;
                    font-size: 16px;
                    margin: 0 0 8px 0;
                }


                .producto p {
                    color: #bbbbbb;
                    font-size: 13px;
                    margin: 5px 0;
                }


            .stock {
                color: #70c070 !important;
                font-weight: bold;
            }


            .agregar {
                width: 100%;
                margin-top: 10px;
                background-color: #d4af37;
                color: #1a1a1a;
                border: none;
                border-radius: 5px;
                padding: 8px;
                font-weight: bold;
                cursor: pointer;
            }


                .agregar:hover {
                    background-color: #e6c65c;
                }



            /* CARRITO */

            .carrito {
                background-color: #222222;
                border: 1px solid #444444;
                border-radius: 8px;
                padding: 20px;
                display: flex;
                flex-direction: column;
            }


            .carrito-titulo {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #444444;
                padding-bottom: 15px;
                margin-bottom: 15px;
            }


                .carrito-titulo h2 {
                    color: #d4af37;
                    margin: 0;
                    font-size: 20px;
                }


            .cantidad {
                background-color: #d4af37;
                color: #1a1a1a;
                border-radius: 50%;
                width: 25px;
                height: 25px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
            }



            /* ITEMS DEL CARRITO */

            .items {
                flex: 1;
                overflow: auto;
            }


            .item {
                background-color: #2b2b2b;
                border-radius: 6px;
                padding: 12px;
                margin-bottom: 10px;
                display: flex;
                justify-content: space-between;
            }


            .item-nombre {
                font-weight: bold;
            }


            .item-info {
                color: #999999;
                font-size: 12px;
                margin-top: 5px;
            }


            .item-precio {
                color: #d4af37;
                font-weight: bold;
            }



            /* RESUMEN */

            .resumen {
                border-top: 1px solid #444444;
                padding-top: 15px;
                margin-top: 10px;
            }


            .fila {
                display: flex;
                justify-content: space-between;
                margin-bottom: 10px;
                color: #cccccc;
            }


            .total {
                display: flex;
                justify-content: space-between;
                font-size: 22px;
                font-weight: bold;
                margin-top: 15px;
            }


                .total span:last-child {
                    color: #d4af37;
                }


            .confirmar {
                width: 100%;
                background-color: #d4af37;
                color: #1a1a1a;
                border: none;
                border-radius: 5px;
                padding: 13px;
                margin-top: 15px;
                font-size: 16px;
                font-weight: bold;
                cursor: pointer;
            }


                .confirmar:hover {
                    background-color: #e6c65c;
                }

    </style>

</head>


<body>


    <!-- ENCABEZADO -->

    <header class="encabezado">

        <div class="logo">
            FLOMAR
        </div>


        <div>

            <span class="usuario">
                Vendedor
            </span>

            <button class="cerrar">
                Cerrar sesión
            </button>

        </div>

    </header>



    <!-- CONTENIDO -->

    <main class="contenido">

        <h1 class="titulo">
            Punto de venta <span>FLOMAR</span>
        </h1>



        <div class="zona">


            <!-- PRODUCTOS -->

            <section class="productos">


                <div class="busqueda">

                    <input type="text"
