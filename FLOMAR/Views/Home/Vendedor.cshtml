                    </button>

                    <button class="categoria">
                        Aros
                    </button>

                </div>



                <!-- PRODUCTOS -->

                <div class="lista-productos">


                    <div class="producto">

                        <h3>
                            Aro Enkei
                        </h3>

                        <p>
                            Código: AR-001
                        </p>

                        <p>
                            Bs. 850
                        </p>

                        <p class="stock">
                            Stock: 8
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>



                    <div class="producto">

                        <h3>
                            Disco de Freno
                        </h3>

                        <p>
                            Código: FR-002
                        </p>

                        <p>
                            Bs. 320
                        </p>

                        <p class="stock">
                            Stock: 15
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>



                    <div class="producto">

                        <h3>
                            Filtro de Aceite
                        </h3>

                        <p>
                            Código: FI-003
                        </p>

                        <p>
                            Bs. 75
                        </p>

                        <p class="stock">
                            Stock: 20
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>



                    <div class="producto">

                        <h3>
                            Pastillas de Freno
                        </h3>

                        <p>
                            Código: FR-004
                        </p>

                        <p>
                            Bs. 180
                        </p>

                        <p class="stock">
                            Stock: 12
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>



                    <div class="producto">

                        <h3>
                            Filtro de Aire
                        </h3>

                        <p>
                            Código: FI-005
                        </p>

                        <p>
                            Bs. 110
                        </p>

                        <p class="stock">
                            Stock: 7
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>



                    <div class="producto">

                        <h3>
                            Aro Deportivo
                        </h3>

                        <p>
                            Código: AR-006
                        </p>

                        <p>
                            Bs. 720
                        </p>

                        <p class="stock">
                            Stock: 5
                        </p>

                        <button class="agregar">
                            + Agregar
                        </button>

                    </div>


                </div>


            </section>



            <!-- CARRITO -->

            <aside class="carrito">


                <div class="carrito-titulo">

                    <h2>
                        Carrito
                    </h2>

                    <div class="cantidad">
                        3
                    </div>

                </div>



                <div class="items">


                    <div class="item">

                        <div>

                            <div class="item-nombre">
                                Aro Enkei
                            </div>

                            <div class="item-info">
                                Cantidad: 1
                            </div>

                        </div>

                        <div class="item-precio">
                            Bs. 850
                        </div>

                    </div>



                    <div class="item">

                        <div>

                            <div class="item-nombre">
                                Disco de Freno
                            </div>

                            <div class="item-info">
                                Cantidad: 2
                            </div>

                        </div>

                        <div class="item-precio">
                            Bs. 640
                        </div>

                    </div>



                    <div class="item">

                        <div>

                            <div class="item-nombre">
                                Filtro de Aceite
                            </div>

                            <div class="item-info">
                                Cantidad: 1
                            </div>

                        </div>

                        <div class="item-precio">
                            Bs. 75
                        </div>

                    </div>


                </div>



                <!-- RESUMEN -->

                <div class="resumen">

                    <div class="fila">

                        <span>
                            Productos
                        </span>

                        <span>
                            4
                        </span>

                    </div>


                    <div class="fila">

                        <span>
                            Subtotal
                        </span>

                        <span>
                            Bs. 1.565
                        </span>

                    </div>


                    <div class="total">

                        <span>
                            TOTAL
                        </span>

                        <span>
                            Bs. 1.565
                        </span>

                    </div>


                    <button class="confirmar">
                        Confirmar venta
                    </button>

                </div>


            </aside>


        </div>

    </main>


</body>

</html>
