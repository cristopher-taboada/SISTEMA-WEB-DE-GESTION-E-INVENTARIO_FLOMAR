@model IEnumerable<FLOMAR.Models.Repuesto>

@{
    Layout = null;

    int rol = FLOMAR.Controllers.LoginController.RolActual;
    string textoRol = (rol == 1) ? "Administrador" : "Vendedor";
    string urlRetorno = (rol == 1) ? "/Home/Admin" : "/Home/Index";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>Punto de Venta - FLOMAR</title>

    <style>

            body {
                margin: 0;
                background-color: #1a1a1a;
                color: #ffffff;
                font-family: Arial, sans-serif;
            }

            header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 30px;
                background-color: #1c1c1c;
                border-bottom: 1px solid #333;
            }

            .header-logo {
                color: #d4af37;
                font-size: 20px;
                font-weight: bold;
            }

            .header-user {
                display: flex;
                align-items: center;
                gap: 20px;
                font-size: 14px;
                color: #ccc;
            }

            .btn-cerrar {
                background: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                padding: 8px 15px;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                transition: all 0.25s ease;
            }

            .btn-cerrar:hover {
                background: #d4af37;
                color: #1a1a1a;
            }

            .btn-volver {
                background: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                padding: 8px 15px;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-size: 14px;
                font-weight: bold;
                transition: all 0.25s ease;
            }

            .btn-volver:hover {
                background: #d4af37;
                color: #1a1a1a;
            }

            .container {
                padding: 20px 30px;
            }

            .page-title {
                font-size: 24px;
                margin-bottom: 25px;
                margin-top: 0;
                font-weight: bold;
            }

            .page-title span {
                color: #d4af37;
            }

            .main-layout {
                display: flex;
                gap: 20px;
                align-items: flex-start;
            }

            .left-panel {
                flex: 1;
                background-color: #242424;
                border-radius: 6px;
                padding: 25px;
                border: 1px solid #333;
            }

            .right-panel {
                width: 340px;
                background-color: #242424;
                border-radius: 6px;
                padding: 25px;
                border: 1px solid #333;
                display: flex;
                flex-direction: column;
            }

            .search-bar {
                display: flex;
                gap: 12px;
                margin-bottom: 20px;
            }

            .search-bar input {
                flex: 1;
                padding: 12px 15px;
                background-color: #1a1a1a;
                border: 1px solid #333;
                border-radius: 4px;
                color: #fff;
                font-size: 14px;
            }

            .search-bar input:focus {
                outline: none;
                border-color: #d4af37;
            }

            .btn-buscar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 0 30px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                font-size: 14px;
            }

            .btn-buscar:hover {
                background-color: #d4af37;
            }

            .categories {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-bottom: 25px;
            }

            .cat-btn {
                background-color: transparent;
                border: 1px solid #444;
                color: #aaa;
                padding: 7px 18px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 13px;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                line-height: 20px;
            }

            .cat-btn:hover {
                border-color: #d4af37;
                color: #d4af37;
            }

            .cat-btn.active {
                background-color: #e4c554;
                color: #1a1a1a;
                border-color: #e4c554;
                font-weight: bold;
            }

            .products-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 15px;
            }

            .product-card {
                background-color: #2b2b2b;
                border: 1px solid #3a3a3a;
                border-radius: 6px;
                padding: 18px;
                display: flex;
                flex-direction: column;
            }

            .product-title {
                color: #e4c554;
                margin: 0 0 10px 0;
                font-size: 16px;
                font-weight: bold;
            }

            .product-info {
                color: #ccc;
                font-size: 13px;
                margin: 4px 0;
            }

            .product-stock {
                color: #4caf50;
                font-size: 13px;
                margin: 4px 0 15px 0;
            }

            .btn-agregar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 10px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                width: 100%;
                margin-top: auto;
            }

            .btn-agregar:hover {
                background-color: #d4af37;
            }

            .carrito-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            .carrito-title {
                color: #e4c554;
                font-size: 18px;
                margin: 0;
                font-weight: bold;
            }

            .carrito-badge {
                background-color: #e4c554;
                color: #1a1a1a;
                font-weight: bold;
                border-radius: 50%;
                width: 24px;
                height: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
            }

            #lista-carrito {
                flex: 1;
                max-height: 300px;
                overflow-y: auto;
                margin-bottom: 15px;
            }

            .cart-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #333;
                padding-bottom: 10px;
                margin-bottom: 10px;
            }

            .cart-item-name {
                font-weight: bold;
                font-size: 14px;
                margin-bottom: 3px;
                color: #fff;
            }

            .cart-item-qty {
                color: #888;
                font-size: 12px;
            }

            .cart-item-price {
                color: #e4c554;
                font-weight: bold;
                font-size: 14px;
            }

            .btn-quitar {
                background: transparent;
                color: #ff5252;
                border: none;
                cursor: pointer;
                font-size: 12px;
                padding: 0;
                margin-top: 4px;
            }

            .btn-quitar:hover {
                text-decoration: underline;
            }

            .carrito-summary {
                border-top: 1px solid #444;
                padding-top: 15px;
            }

            .summary-row {
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                color: #aaa;
                margin-bottom: 8px;
            }

            .summary-total {
                display: flex;
                justify-content: space-between;
                font-size: 18px;
                font-weight: bold;
                color: #fff;
                margin-bottom: 15px;
            }

            .summary-total span:last-child {
                color: #d4af37;
            }

            .btn-confirmar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 12px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                width: 100%;
                font-size: 14px;
            }

            .btn-confirmar:hover {
                background-color: #d4af37;
            }

    </style>

</head>

<body>

    <header>

        <div class="header-logo">
            FLOMAR
        </div>

        <div class="header-user">

            <span style="color: #d4af37; font-weight: bold;">
                Rol: @textoRol
            </span>

            <a href="@urlRetorno" class="btn-volver">
                Volver al panel
            </a>

            <a href="/Login/Index" class="btn-cerrar">
                Cerrar sesión
            </a>

        </div>

    </header>


    <div class="container">

        <h1 class="page-title">
            Punto de venta <span>FLOMAR</span>
        </h1>


        <div class="main-layout">


            <div class="left-panel">


                <form class="search-bar"
                      asp-controller="Home"
                      asp-action="Vendedor"
                      method="get">

                    <input type="text"
                           name="textoBusqueda"
                           list="lista-repuestos"
                           value="@ViewBag.TextoBusqueda"
                           placeholder="Buscar repuesto por nombre o código..."
                           autocomplete="off" />

                    @if (ViewBag.IdCategoria != null)
                    {
                        <input type="hidden"
                               name="idCategoria"
                               value="@ViewBag.IdCategoria" />
                    }


                    <datalist id="lista-repuestos">

                        @if (Model != null)
                        {
                            foreach (var repuesto in Model)
                            {
                                <option value="@repuesto.Nombre"></option>
                            }
                        }

                    </datalist>


                    <button type="submit"
                            class="btn-buscar">
                        Buscar
                    </button>

                </form>


                <div class="categories">

                    <a href="@Url.Action("Vendedor", "Home")"
                       class="cat-btn @(ViewBag.IdCategoria == null ? "active" : "")">
                        Todos
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 1 })"
                       class="cat-btn @(ViewBag.IdCategoria == 1 ? "active" : "")">
                        Frenos
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 2 })"
                       class="cat-btn @(ViewBag.IdCategoria == 2 ? "active" : "")">
                        Suspensión
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 3 })"
                       class="cat-btn @(ViewBag.IdCategoria == 3 ? "active" : "")">
                        Motor
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 4 })"
                       class="cat-btn @(ViewBag.IdCategoria == 4 ? "active" : "")">
                        Eléctrico
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 5 })"
                       class="cat-btn @(ViewBag.IdCategoria == 5 ? "active" : "")">
                        Aceites
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 6 })"
                       class="cat-btn @(ViewBag.IdCategoria == 6 ? "active" : "")">
                        Transmisión
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 7 })"
                       class="cat-btn @(ViewBag.IdCategoria == 7 ? "active" : "")">
                        Carrocería
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 8 })"
                       class="cat-btn @(ViewBag.IdCategoria == 8 ? "active" : "")">
                        Interior
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 9 })"
                       class="cat-btn @(ViewBag.IdCategoria == 9 ? "active" : "")">
                        Dirección
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 10 })"
                       class="cat-btn @(ViewBag.IdCategoria == 10 ? "active" : "")">
                        Refrigeración
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 11 })"
                       class="cat-btn @(ViewBag.IdCategoria == 11 ? "active" : "")">
                        Filtros
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 12 })"
                       class="cat-btn @(ViewBag.IdCategoria == 12 ? "active" : "")">
                        Iluminación
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 13 })"
                       class="cat-btn @(ViewBag.IdCategoria == 13 ? "active" : "")">
                        Accesorios
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 14 })"
                       class="cat-btn @(ViewBag.IdCategoria == 14 ? "active" : "")">
                        Herramientas
                    </a>

                    <a href="@Url.Action("Vendedor", "Home", new { idCategoria = 15 })"
                       class="cat-btn @(ViewBag.IdCategoria == 15 ? "active" : "")">
                        Limpieza
                    </a>

                </div>


                <div class="products-grid">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var repuesto in Model)
                        {
                            <div class="product-card">

                                <h3 class="product-title">
                                    @repuesto.Nombre
                                </h3>

                                <p class="product-info">
                                    Código: @repuesto.Codigo
                                </p>

                                <p class="product-info">
                                    Precio: Bs.
                                    <span class="precio-val">
                                        @repuesto.PrecioVenta
                                    </span>
                                </p>

                                <p class="product-stock">
                                    Stock: @repuesto.Stock
                                </p>

                                <button type="button"
                                        class="btn-agregar"
                                        onclick="agregarAlCarrito(@repuesto.Id, '@repuesto.Nombre', @repuesto.PrecioVenta)">
                                    + Agregar
                                </button>

                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: #888;
                            grid-column: 1 / -1;
                            text-align: center;
                            padding: 30px;">

                            No se encontraron repuestos registrados
                            en la base de datos con ese criterio.

                        </p>
                    }

                </div>

            </div>


            <div class="right-panel">

                <div class="carrito-header">

                    <h2 class="carrito-title">
                        Carrito
                    </h2>

                    <div class="carrito-badge"
                         id="badge-contador">
                        0
                    </div>

                </div>


                <div id="lista-carrito">

                    <p id="carrito-vacio"
                       style="color: #888;
                        font-size: 13px;
                        text-align: center;
                        margin-top: 20px;">

                        Aún no hay productos en el carrito.

                    </p>

                </div>


                <div class="carrito-summary">

                    <div class="summary-row">
                        <span>Productos</span>
                        <span id="total-productos">0</span>
                    </div>

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>
                            Bs.
                            <span id="subtotal-monto">0.00</span>
                        </span>
                    </div>

                    <div class="summary-row">
                        <span>IVA (13%)</span>
                        <span>
                            Bs.
                            <span id="iva-monto">0.00</span>
                        </span>
                    </div>

                    <div class="summary-total">
                        <span>TOTAL</span>
                        <span>
                            Bs.
                            <span id="total-monto">0.00</span>
                        </span>
                    </div>

                    <button type="button"
                            class="btn-confirmar"
                            onclick="confirmarVenta()">
                        Confirmar venta
                    </button>

                </div>

            </div>

        </div>

    </div>


    <script>

            let carrito = [];

            function agregarAlCarrito(id, nombre, precio) {

                let item = carrito.find(p => p.id === id);

                if (item) {
                    item.cantidad++;
                }
                else {
                    carrito.push({
                        id: id,
                        nombre: nombre,
                        precio: precio,
                        cantidad: 1
                    });
                }

                actualizarCarrito();
            }


            function eliminarDelCarrito(id) {

                carrito = carrito.filter(p => p.id !== id);

                actualizarCarrito();
            }


            function actualizarCarrito() {

                const lista =
                    document.getElementById('lista-carrito');

                const badge =
                    document.getElementById('badge-contador');

                const totalProd =
                    document.getElementById('total-productos');

                const subtotalMonto =
                    document.getElementById('subtotal-monto');

                const ivaMonto =
                    document.getElementById('iva-monto');

                const totalMonto =
                    document.getElementById('total-monto');


                lista.innerHTML = '';


                if (carrito.length === 0) {

                    lista.innerHTML =
                        '<p id="carrito-vacio" style="color: #888; font-size: 13px; text-align: center; margin-top: 20px;">Aún no hay productos en el carrito.</p>';

                    badge.innerText = '0';
                    totalProd.innerText = '0';
                    subtotalMonto.innerText = '0.00';
                    ivaMonto.innerText = '0.00';
                    totalMonto.innerText = '0.00';

                    return;
                }


                let totalItemsCount = 0;
                let sumaSubtotal = 0;


                carrito.forEach(prod => {

                    totalItemsCount += prod.cantidad;

                    let subtotalProd =
                        prod.precio * prod.cantidad;

                    sumaSubtotal += subtotalProd;


                    let div =
                        document.createElement('div');

                    div.className = 'cart-item';


                    div.innerHTML = `
                                <div>
                                    <div class="cart-item-name">
                                        ${prod.nombre}
                                    </div>

                                    <div class="cart-item-qty">
                                        Cantidad: ${prod.cantidad}
                                        (Bs. ${prod.precio} c/u)
                                    </div>

                                    <button type="button"
                                            class="btn-quitar"
                                            onclick="eliminarDelCarrito(${prod.id})">
                                        Eliminar
                                    </button>
                                </div>

                                <div class="cart-item-price">
                                    Bs. ${subtotalProd}
                                </div>
                            `;


                    lista.appendChild(div);

                });


                let ivaCalculado =
                    sumaSubtotal * 0.13;

                let sumaTotalFinal =
                    sumaSubtotal + ivaCalculado;


                badge.innerText =
                    totalItemsCount;

                totalProd.innerText =
                    totalItemsCount;

                subtotalMonto.innerText =
                    sumaSubtotal.toFixed(2);

                ivaMonto.innerText =
                    ivaCalculado.toFixed(2);

                totalMonto.innerText =
                    sumaTotalFinal.toFixed(2);
            }


            async function confirmarVenta() {

                if (carrito.length === 0) {

                    alert('El carrito esta vacio.');

                    return;
                }


                if (!confirm('¿Confirmar la venta?'))
                    return;


                const lineas = carrito.map(p => ({
                    id_repuesto: p.id,
                    cantidad: p.cantidad
                }));


                try {

                    const resp =
                        await fetch('/Ventas/Confirmar', {

                            method: 'POST',

                            headers: {
                                'Content-Type': 'application/json'
                            },

                            body: JSON.stringify({
                                id_metodo_pago: 1,
                                lineas: lineas
                            })

                        });


                    const data =
                        await resp.json();


                    if (resp.ok && data.ok) {

                        window.location.href =
                            '/Ventas/Detalle/' + data.idVenta;

                    }
                    else {

                        alert(
                            'No se pudo registrar la venta: ' +
                            (data.mensaje || 'Error desconocido')
                        );

                    }

                }
                catch (e) {

                    alert(
                        'Error de conexion al registrar la venta.'
                    );

                }

            }

    </script>

</body>

</html>