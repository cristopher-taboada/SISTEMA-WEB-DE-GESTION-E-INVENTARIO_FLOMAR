@model IEnumerable<FLOMAR.Models.Repuesto>
@{
    Layout = null;
    int rol = FLOMAR.Controllers.LoginController.RolActual;
    string textoRol = (rol == 1) ? "Administrador" : "Vendedor";
    string urlRetorno = (rol == 1) ? "/Home/Admin" : "/Home/Index";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Punto de Venta - FLOMAR</title>
    <style>
            body {
                margin: 0;
                background-color: #1a1a1a;
                color: #ffffff;
                font-family: Arial, sans-serif;
            }

            header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 15px 30px;
                background-color: #1c1c1c;
                border-bottom: 1px solid #333;
            }

            .header-logo {
                color: #d4af37;
                font-size: 20px;
                font-weight: bold;
            }

            .header-user {
                display: flex;
                align-items: center;
                gap: 20px;
                font-size: 14px;
                color: #ccc;
            }

            .btn-cerrar, .btn-volver {
                background: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                padding: 8px 15px;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-size: 14px;
                font-weight: bold;
                transition: all 0.25s ease;
            }

                .btn-cerrar:hover, .btn-volver:hover {
                    background: #d4af37;
                    color: #1a1a1a;
                }

            .container {
                padding: 20px 30px;
            }

            .page-title {
                font-size: 24px;
                margin-bottom: 25px;
                margin-top: 0;
                font-weight: bold;
            }

                .page-title span {
                    color: #d4af37;
                }

            .main-layout {
                display: flex;
                gap: 20px;
                align-items: flex-start;
            }

            .left-panel {
                flex: 1;
                background-color: #242424;
                border-radius: 6px;
                padding: 25px;
                border: 1px solid #333;
            }

            .right-panel {
                width: 340px;
                background-color: #242424;
                border-radius: 6px;
                padding: 25px;
                border: 1px solid #333;
                display: flex;
                flex-direction: column;
            }

            /* Buscador y Productos */
            .search-bar {
                display: flex;
                gap: 12px;
                margin-bottom: 20px;
            }

                .search-bar input {
                    flex: 1;
                    padding: 12px 15px;
                    background-color: #1a1a1a;
                    border: 1px solid #333;
                    border-radius: 4px;
                    color: #fff;
                    font-size: 14px;
                }

                    .search-bar input:focus {
                        outline: none;
                        border-color: #d4af37;
                    }

            .btn-buscar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 0 30px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                font-size: 14px;
            }

                .btn-buscar:hover {
                    background-color: #d4af37;
                }

            .categories {
                display: flex;
                gap: 10px;
                margin-bottom: 25px;
            }

            .cat-btn {
                background-color: transparent;
                border: 1px solid #444;
                color: #aaa;
                padding: 7px 18px;
                border-radius: 4px;
                cursor: pointer;
                font-size: 13px;
                text-decoration: none;
                display: inline-block;
                text-align: center;
                line-height: 20px;
            }

                .cat-btn.active {
                    background-color: #e4c554;
                    color: #1a1a1a;
                    border-color: #e4c554;
                    font-weight: bold;
                }

            .products-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 15px;
            }

            .product-card {
                background-color: #2b2b2b;
                border: 1px solid #3a3a3a;
                border-radius: 6px;
                padding: 18px;
                display: flex;
                flex-direction: column;
            }

            .product-title {
                color: #e4c554;
                margin: 0 0 10px 0;
                font-size: 16px;
                font-weight: bold;
            }

            .product-info {
                color: #ccc;
                font-size: 13px;
                margin: 4px 0;
            }

            .product-stock {
                color: #4caf50;
                font-size: 13px;
                margin: 4px 0 15px 0;
            }

            .btn-agregar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 10px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                width: 100%;
                margin-top: auto;
            }

                .btn-agregar:hover {
                    background-color: #d4af37;
                }

            /* Carrito */
            .carrito-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            .carrito-title {
                color: #e4c554;
                font-size: 18px;
                margin: 0;
                font-weight: bold;
            }

            .carrito-badge {
                background-color: #e4c554;
                color: #1a1a1a;
                font-weight: bold;
                border-radius: 50%;
                width: 24px;
                height: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
            }

            #lista-carrito {
                flex: 1;
                max-height: 300px;
                overflow-y: auto;
                margin-bottom: 15px;
            }

            .cart-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px solid #333;
                padding-bottom: 10px;
                margin-bottom: 10px;
            }

            .cart-item-name {
                font-weight: bold;
                font-size: 14px;
                margin-bottom: 3px;
                color: #fff;
            }

            .cart-item-qty {
                color: #888;
                font-size: 12px;
            }

            .cart-item-price {
                color: #e4c554;
                font-weight: bold;
                font-size: 14px;
            }

            .btn-quitar {
                background: transparent;
                color: #ff5252;
                border: none;
                cursor: pointer;
                font-size: 12px;
                padding: 0;
                margin-top: 4px;
            }

                .btn-quitar:hover {
                    text-decoration: underline;
                }

            .carrito-summary {
                border-top: 1px solid #444;
                padding-top: 15px;
            }

            .summary-row {
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                color: #aaa;
                margin-bottom: 8px;
            }

            .summary-total {
                display: flex;
                justify-content: space-between;
                font-size: 18px;
                font-weight: bold;
                color: #fff;
                margin-bottom: 15px;
            }

                .summary-total span:last-child {
                    color: #d4af37;
                }

            .btn-confirmar {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 12px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                width: 100%;
                font-size: 14px;
            }

                .btn-confirmar:hover {
                    background-color: #d4af37;
                }

            /* Métodos de Pago */
            .payment-methods {
                display: flex;
                gap: 10px;
                margin-bottom: 15px;
            }

                .payment-methods input[type="radio"] {
                    display: none;
                }

            .pay-btn {
                flex: 1;
                background-color: transparent;
                border: 1px solid #444;
                color: #aaa;
                padding: 10px;
                border-radius: 4px;
                cursor: pointer;
                text-align: center;
                font-size: 13px;
                transition: all 0.2s;
            }

            .payment-methods input[type="radio"]:checked + .pay-btn {
                background-color: #e4c554;
                color: #1a1a1a;
                border-color: #e4c554;
                font-weight: bold;
            }

            /* --- ESTILOS DEL MODAL QR --- */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-color: rgba(0, 0, 0, 0.85);
                display: none;
                justify-content: center;
                align-items: center;
                z-index: 1000;
            }

            .modal-content {
                background-color: #242424;
                border: 1px solid #d4af37;
                border-radius: 8px;
                padding: 30px;
                text-align: center;
                width: 320px;
                box-shadow: 0 5px 25px rgba(0,0,0,0.8);
            }

                .modal-content h2 {
                    color: #d4af37;
                    margin-top: 0;
                    font-size: 22px;
                }

                .modal-content p {
                    color: #ccc;
                    font-size: 14px;
                    margin-bottom: 20px;
                    line-height: 1.5;
                }

            .qr-box {
                background: white;
                padding: 15px;
                border-radius: 8px;
                display: inline-block;
                margin-bottom: 25px;
            }

            .btn-modal-confirm {
                background-color: #e4c554;
                color: #1a1a1a;
                border: none;
                padding: 12px 20px;
                border-radius: 4px;
                font-weight: bold;
                cursor: pointer;
                width: 100%;
                margin-bottom: 10px;
                font-size: 14px;
            }

                .btn-modal-confirm:hover {
                    background-color: #d4af37;
                }

            .btn-modal-cancel {
                background-color: transparent;
                color: #aaa;
                border: 1px solid #555;
                padding: 10px 20px;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 13px;
            }

                .btn-modal-cancel:hover {
                    background-color: #333;
                    color: #fff;
                }
    </style>
</head>
<body>
    <header>
        <div class="header-logo">FLOMAR</div>
        <div class="header-user">
            <span style="color: #d4af37; font-weight: bold;">Rol: @textoRol</span>
            <a href="@urlRetorno" class="btn-volver">Volver al panel</a>
            <a href="/Login/Index" class="btn-cerrar">Cerrar sesión</a>
        </div>
    </header>

    <div class="container">
        <h1 class="page-title">Punto de venta <span>FLOMAR</span></h1>

        <div class="main-layout">

            <!-- PANEL IZQUIERDO -->
            <div class="left-panel">
                <form class="search-bar" asp-controller="Home" asp-action="Vendedor" method="get">
                    <input type="text" name="textoBusqueda" list="lista-repuestos" value="@Context.Request.Query["textoBusqueda"]" placeholder="Buscar repuesto por nombre o código..." autocomplete="off">
                    <datalist id="lista-repuestos">
                        @if (Model != null)
                        {
                            foreach (var repuesto in Model)
                            {
                                <option value="@repuesto.Nombre"></option>
                            }
                        }
                    </datalist>
                    <button type="submit" class="btn-buscar">Buscar</button>
                </form>

                <div class="categories">
                    <a href="@Url.Action("Vendedor", "Home")" class="cat-btn active">Todos</a>
                    <button type="button" class="cat-btn">Frenos</button>
                    <button type="button" class="cat-btn">Filtros</button>
                    <button type="button" class="cat-btn">Aros</button>
                </div>

                <div class="products-grid">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var repuesto in Model)
                        {
                            <div class="product-card">
                                <h3 class="product-title">@repuesto.Nombre</h3>
                                <p class="product-info">Código: @repuesto.Codigo</p>
                                <p class="product-info">Precio: Bs. <span class="precio-val">@repuesto.PrecioVenta</span></p>
                                <p class="product-stock">Stock: @repuesto.Stock</p>
                                <button type="button" class="btn-agregar" onclick="agregarAlCarrito(@repuesto.Id, '@repuesto.Nombre', @repuesto.PrecioVenta)">+ Agregar</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="color: #888; grid-column: 1 / -1; text-align: center; padding: 30px;">
                            No se encontraron repuestos registrados en la base de datos.
                        </p>
                    }
                </div>
            </div>

            <!-- CARRITO Y RESUMEN -->
            <div class="right-panel">
                <div class="carrito-header">
                    <h2 class="carrito-title">Carrito</h2>
                    <div class="carrito-badge" id="badge-contador">0</div>
                </div>

                <div id="lista-carrito">
                    <p id="carrito-vacio" style="color: #888; font-size: 13px; text-align: center; margin-top: 20px;">
                        Aún no hay productos en el carrito.
                    </p>
                </div>

                <div class="carrito-summary">
                    <div class="summary-row">
                        <span>Productos</span>
                        <span id="total-productos">0</span>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>Bs. <span id="subtotal-monto">0.00</span></span>
                    </div>
                    <div class="summary-row">
                        <span>IVA (13%)</span>
                        <span>Bs. <span id="iva-monto">0.00</span></span>
                    </div>
                    <div class="summary-total">
                        <span>TOTAL</span>
                        <span>Bs. <span id="total-monto">0.00</span></span>
                    </div>

                    <!-- BOTONES DE MÉTODO DE PAGO -->
                    <div style="color: #ccc; font-size: 14px; margin-bottom: 10px;">Método de Pago:</div>
                    <div class="payment-methods">
                        <input type="radio" name="metodoPago" id="pagoEfectivo" value="1" checked>
                        <label for="pagoEfectivo" class="pay-btn">Efectivo</label>

                        <input type="radio" name="metodoPago" id="pagoQR" value="2">
                        <label for="pagoQR" class="pay-btn">Pago QR</label>
                    </div>

                    <button type="button" class="btn-confirmar" onclick="iniciarVenta()">Confirmar venta</button>
                </div>
            </div>

        </div>
    </div>

    <!-- MODAL FLOTANTE DEL QR -->
    <div id="modalQR" class="modal-overlay">
        <div class="modal-content">
            <h2>Pago mediante QR</h2>
            <p>Muestre este código al cliente para que realice la transferencia por <strong>Bs. <span id="qr-total-monto">0.00</span></strong>.</p>

            <div class="qr-box">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=Pago-FLOMAR" alt="QR de Pago" width="150" height="150" style="display: block;" />
            </div>

            <button type="button" class="btn-modal-confirm" onclick="procesarVentaEnServidor()">Confirmar Pago Recibido</button>
            <button type="button" class="btn-modal-cancel" onclick="cerrarModalQR()">Cancelar / Volver</button>
        </div>
    </div>

    <script>
            let carrito = [];
            let sumaTotalFinal = 0;

            function agregarAlCarrito(id, nombre, precio) {
                let item = carrito.find(p => p.id === id);
                if (item) {
                    item.cantidad++;
                } else {
                    carrito.push({ id: id, nombre: nombre, precio: precio, cantidad: 1 });
                }
                actualizarCarrito();
            }

            function eliminarDelCarrito(id) {
                carrito = carrito.filter(p => p.id !== id);
                actualizarCarrito();
            }

            function actualizarCarrito() {
                const lista = document.getElementById('lista-carrito');
                const badge = document.getElementById('badge-contador');
                const totalProd = document.getElementById('total-productos');
                const subtotalMonto = document.getElementById('subtotal-monto');
                const ivaMonto = document.getElementById('iva-monto');
                const totalMonto = document.getElementById('total-monto');
                const qrTotalMonto = document.getElementById('qr-total-monto');

                lista.innerHTML = '';

                if (carrito.length === 0) {
                    lista.innerHTML = '<p id="carrito-vacio" style="color: #888; font-size: 13px; text-align: center; margin-top: 20px;">Aún no hay productos en el carrito.</p>';
                    badge.innerText = '0';
                    totalProd.innerText = '0';
                    subtotalMonto.innerText = '0.00';
                    ivaMonto.innerText = '0.00';
                    totalMonto.innerText = '0.00';
                    sumaTotalFinal = 0;
                    qrTotalMonto.innerText = '0.00';
                    return;
                }

                let totalItemsCount = 0;
                let sumaSubtotal = 0;

                carrito.forEach(prod => {
                    totalItemsCount += prod.cantidad;
                    let subtotalProd = prod.precio * prod.cantidad;
                    sumaSubtotal += subtotalProd;

                    let div = document.createElement('div');
                    div.className = 'cart-item';
                    div.innerHTML = `
                        <div>
                            <div class="cart-item-name">${prod.nombre}</div>
                            <div class="cart-item-qty">Cantidad: ${prod.cantidad} (Bs. ${prod.precio} c/u)</div>
                            <button type="button" class="btn-quitar" onclick="eliminarDelCarrito(${prod.id})">Eliminar</button>
                        </div>
                        <div class="cart-item-price">Bs. ${subtotalProd.toFixed(2)}</div>
                    `;
                    lista.appendChild(div);
                });

                let ivaCalculado = sumaSubtotal * 0.13;
                sumaTotalFinal = sumaSubtotal + ivaCalculado;

                badge.innerText = totalItemsCount;
                totalProd.innerText = totalItemsCount;
                subtotalMonto.innerText = sumaSubtotal.toFixed(2);
                ivaMonto.innerText = ivaCalculado.toFixed(2);
                totalMonto.innerText = sumaTotalFinal.toFixed(2);
                qrTotalMonto.innerText = sumaTotalFinal.toFixed(2);
            }

            // FUNCIÓN 1: Decide si guarda directo o si muestra la ventana del QR
            function iniciarVenta() {
                if (carrito.length === 0) {
                    alert('El carrito esta vacio.');
                    return;
                }

                const metodoSeleccionado = document.querySelector('input[name="metodoPago"]:checked').value;

                if (metodoSeleccionado === "2") {
                    // Si es QR, mostramos la ventana flotante oscura
                    document.getElementById('modalQR').style.display = 'flex';
                } else {
                    // Si es Efectivo, le preguntamos normal y guardamos
                    if (confirm('¿Confirmar el cobro en Efectivo por Bs. ' + sumaTotalFinal.toFixed(2) + '?')) {
                        procesarVentaEnServidor();
                    }
                }
            }

            function cerrarModalQR() {
                document.getElementById('modalQR').style.display = 'none';
            }

            // FUNCIÓN 2: Hace el envío real a la API una vez que se confirmó todo
            async function procesarVentaEnServidor() {
                const metodoSeleccionado = document.querySelector('input[name="metodoPago"]:checked').value;
                const lineas = carrito.map(p => ({ id_repuesto: p.id, cantidad: p.cantidad }));

                try {
                    const resp = await fetch('/Ventas/Confirmar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id_metodo_pago: parseInt(metodoSeleccionado), lineas: lineas })
                    });
                    const data = await resp.json();

                    if (resp.ok && data.ok) {
                        window.location.href = '/Ventas/Detalle/' + data.idVenta;
                    } else {
                        alert('No se pudo registrar la venta: ' + (data.mensaje || 'Error desconocido'));
                    }
                } catch (e) {
                    alert('Error de conexion al registrar la venta.');
                }
            }
    </script>
</body>
</html>