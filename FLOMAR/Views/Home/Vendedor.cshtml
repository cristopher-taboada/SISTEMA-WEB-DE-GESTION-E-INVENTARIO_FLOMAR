@model IEnumerable<FLOMAR.Models.Repuesto>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <title>Vendedor - FLOMAR</title>
    <style>
            body {
                background: #1a1a1a;
                color: #fff;
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 25px;
            }

            .btn {
                background: #d4af37;
                color: #111;
                border: none;
                padding: 10px 15px;
                cursor: pointer;
                font-weight: bold;
                border-radius: 5px;
            }

                .btn:hover {
                    background: #e6c65c;
                }

            .panel {
                background: #222;
                padding: 20px;
                border-radius: 8px;
                border: 1px solid #444;
            }

            .layout {
                display: grid;
                grid-template-columns: 1fr 300px;
                gap: 20px;
            }

            .grid-productos {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 15px;
                margin-top: 15px;
            }

            .card {
                background: #2b2b2b;
                padding: 15px;
                border-radius: 5px;
                border: 1px solid #444;
            }

            input {
                padding: 10px;
                width: 70%;
                background: #111;
                color: #fff;
                border: 1px solid #555;
                border-radius: 5px;
            }
    </style>
</head>
<body>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px; align-items: center;">
        <h2 style="color: #d4af37; margin: 0;">Punto de Venta FLOMAR</h2>
        <a href="/Login/Index" class="btn" style="background: transparent; color: #d4af37; border: 1px solid #d4af37; text-decoration: none;">Salir</a>
    </div>

    <div class="layout">
        <!-- CATÁLOGO Y BUSCADOR -->
        <div class="panel">
            <form asp-controller="Home" asp-action="Vendedor" method="get" style="margin-bottom: 20px;">
                <input type="text" name="textoBusqueda" placeholder="Buscar repuesto por nombre o código..." autocomplete="off" />
                <button type="submit" class="btn">Buscar</button>
            </form>

            <div class="grid-productos">
                @if (Model != null && Model.Any())
                {
                    foreach (var repuesto in Model)
                    {
                        <div class="card">
                            <h3 style="color:#d4af37; margin:0 0 5px 0;">@repuesto.Nombre</h3>
                            <p style="margin:2px 0; color:#aaa; font-size:14px;">Cód: @repuesto.Codigo</p>
                            <p style="margin:5px 0; font-size:16px;">Bs. @repuesto.PrecioVenta</p>
                            <button class="btn" style="width:100%; margin-top:10px;">+ Agregar</button>
                        </div>
                    }
                }
                else
                {
                    <p style="color: gray;">No se encontraron repuestos.</p>
                }
            </div>
        </div>

        <!-- CARRITO BÁSICO -->
        <div class="panel">
            <h3 style="color: #d4af37; margin-top: 0; border-bottom: 1px solid #444; padding-bottom: 10px;">Carrito (0)</h3>
            <p style="color: #999; font-size: 14px; text-align: center; margin: 30px 0;">Vacío</p>
            <div style="border-top: 1px solid #444; padding-top: 15px; margin-top: 30px;">
                <h3 style="display: flex; justify-content: space-between; margin-bottom: 15px;">TOTAL: <span style="color:#d4af37;">Bs. 0</span></h3>
                <button class="btn" style="width: 100%;">Confirmar Venta</button>
            </div>
        </div>
    </div>

</body>
</html>