                    <button class="buscar">
                        Buscar
                    </button>

                </div>



                <!-- CATEGORIAS -->

                <div class="categorias">

                    <button class="categoria activa">
                        Todos
                    </button>

                    <button class="categoria">
                        Frenos
                    </button>

                    <button class="categoria">
