@{
    ViewData["Title"] = "Inicio - FLOMAR";
}

<style>
    /* =========================
           ESTILOS GENERALES
        ========================== */

    body {
        background-color: #f4f4f4;
        font-family: Arial, Helvetica, sans-serif;
    }

    .flomar-container {
        padding-top: 25px;
        padding-bottom: 50px;
    }


    /* =========================
           PORTADA
        ========================== */

    .hero-flomar {
        background: linear-gradient(135deg, #111111, #292929);
        color: white;
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.20);
    }

        .hero-flomar h1 {
            font-size: 45px;
            font-weight: 800;
            margin-bottom: 15px;
        }

            .hero-flomar h1 span {
                color: #ffc107;
            }

        .hero-flomar p {
            color: #dddddd;
            font-size: 18px;
            max-width: 700px;
        }


    /* =========================
           BOTONES
        ========================== */

    .btn-flomar {
        background-color: #ffc107;
        color: #111111;
        border: none;
        font-weight: bold;
        padding: 11px 24px;
        border-radius: 9px;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
    }

        .btn-flomar:hover {
            background-color: #e0a800;
            color: #000000;
            transform: translateY(-2px);
        }


    /* =========================
           TÍTULOS
        ========================== */

    .titulo-seccion {
        color: #222222;
        font-size: 25px;
        font-weight: bold;
        margin-top: 40px;
        margin-bottom: 20px;
    }


    /* =========================
           TARJETAS DE ESTADÍSTICAS
        ========================== */

    .tarjeta-estadistica {
        background-color: #181818;
        color: white;
        border-radius: 15px;
        padding: 22px;
        height: 100%;
        box-shadow: 0 5px 15px rgba(0,0,0,0.12);
        border-bottom: 4px solid #ffc107;
        transition: 0.3s;
    }

        .tarjeta-estadistica:hover {
            transform: translateY(-5px);
        }

        .tarjeta-estadistica .icono {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .tarjeta-estadistica h6 {
            color: #cccccc;
            font-size: 14px;
        }

        .tarjeta-estadistica h2 {
            color: #ffc107;
            font-weight: bold;
            margin: 8px 0;
        }

        .tarjeta-estadistica small {
            color: #aaaaaa;
        }


    /* =========================
           ACCESOS RÁPIDOS
        ========================== */

    .tarjeta-menu {
        background-color: white;
        border-radius: 15px;
        padding: 28px 20px;
        text-align: center;
        height: 100%;
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
        border-top: 5px solid #ffc107;
        transition: 0.3s;
    }

        .tarjeta-menu:hover {
            transform: translateY(-7px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .tarjeta-menu .icono-menu {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .tarjeta-menu h4 {
            color: #111111;
            font-weight: bold;
        }

        .tarjeta-menu p {
            color: #666666;
            font-size: 14px;
            min-height: 60px;
        }


    /* =========================
           ACTIVIDAD RECIENTE
        ========================== */

    .actividad {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

        .actividad h4 {
            font-weight: bold;
            color: #222222;
        }

    .sin-actividad {
        text-align: center;
        color: #777777;
        padding: 30px;
    }


    /* =========================
           RESPONSIVE
        ========================== */

    @@media (max-width: 768px) {

        .hero-flomar {
            padding: 30px;
        }

            .hero-flomar h1 {
                font-size: 32px;
            }

            .hero-flomar p {
                font-size: 16px;
            }
    }

</style>


<div class="container flomar-container">

    <!-- ========================================
         PORTADA PRINCIPAL
    ========================================= -->

    <div class="hero-flomar">

        <h1>
            Bienvenido a <span>FLOMAR</span>
        </h1>

        <p>
            Sistema Web de Gestión de Ventas e Inventario
            para el control y comercialización de repuestos automotrices.
        </p>

        <a asp-controller="Ventas"
           asp-action="Create"
           class="btn-flomar mt-3">

            🛒 Nueva Venta

        </a>

    </div>


    <!-- ========================================
         RESUMEN DEL NEGOCIO
    ========================================= -->

    <h2 class="titulo-seccion">
        Resumen del negocio
    </h2>


    <div class="row g-4">


        <!-- VENTAS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-estadistica">

                <div class="icono">
                    🛒
                </div>

                <h6>
                    Ventas del día
                </h6>

                <h2>
                    0
                </h2>

                <small>
                    Ventas registradas hoy
                </small>

            </div>

        </div>


        <!-- INGRESOS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-estadistica">

                <div class="icono">
                    💰
                </div>

                <h6>
                    Ingresos de hoy
                </h6>

                <h2>
                    Bs. 0.00
                </h2>

                <small>
                    Total vendido
                </small>

            </div>

        </div>


        <!-- PRODUCTOS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-estadistica">

                <div class="icono">
                    📦
                </div>

                <h6>
                    Productos
                </h6>

                <h2>
                    0
                </h2>

                <small>
                    Productos registrados
                </small>

            </div>

        </div>


        <!-- STOCK BAJO -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-estadistica">

                <div class="icono">
                    ⚠️
                </div>

                <h6>
                    Stock bajo
                </h6>

                <h2>
                    0
                </h2>

                <small>
                    Productos por reponer
                </small>

            </div>

        </div>

    </div>


    <!-- ========================================
         ACCESOS RÁPIDOS
    ========================================= -->

    <h2 class="titulo-seccion">
        Accesos rápidos
    </h2>


    <div class="row g-4">


        <!-- VENTAS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    🛒
                </div>

                <h4>
                    Ventas
                </h4>

                <p>
                    Registrar nuevas ventas y consultar
                    las ventas realizadas.
                </p>

                <a asp-controller="Ventas"
                   asp-action="Index"
                   class="btn-flomar">

                    Ir a Ventas

                </a>

            </div>

        </div>


        <!-- PRODUCTOS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    🔧
                </div>

                <h4>
                    Productos
                </h4>

                <p>
                    Registrar, modificar y consultar
                    los repuestos disponibles.
                </p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Productos

                </a>

            </div>

        </div>


        <!-- INVENTARIO -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    📦
                </div>

                <h4>
                    Inventario
                </h4>

                <p>
                    Consultar existencias, controlar stock
                    y registrar mercadería.
                </p>

                <a asp-controller="Inventario"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Inventario

                </a>

            </div>

        </div>


        <!-- REPORTES -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    📊
                </div>

                <h4>
                    Reportes
                </h4>

                <p>
                    Consultar ventas, inventario,
                    movimientos y rendimiento.
                </p>

                <a asp-controller="Reportes"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Reportes

                </a>

            </div>

        </div>


        <!-- PROVEEDORES -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    🚚
                </div>

                <h4>
                    Proveedores
                </h4>

                <p>
                    Registrar y administrar los proveedores
                    de repuestos de FLOMAR.
                </p>

                <a asp-controller="Proveedores"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Proveedores

                </a>

            </div>

        </div>


        <!-- COMPRAS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    📥
                </div>

                <h4>
                    Compras
                </h4>

                <p>
                    Registrar el ingreso de nueva
                    mercadería al negocio.
                </p>

                <a asp-controller="Compras"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Compras

                </a>

            </div>

        </div>


        <!-- USUARIOS -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    👥
                </div>

                <h4>
                    Usuarios
                </h4>

                <p>
                    Administrar las cuentas del
                    administrador y vendedores.
                </p>

                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Usuarios

                </a>

            </div>

        </div>


        <!-- CAJA -->

        <div class="col-lg-3 col-md-6">

            <div class="tarjeta-menu">

                <div class="icono-menu">
                    💵
                </div>

                <h4>
                    Caja
                </h4>

                <p>
                    Consultar movimientos y realizar
                    el control del arqueo de caja.
                </p>

                <a asp-controller="Caja"
                   asp-action="Index"
                   class="btn-flomar">

                    Ver Caja

                </a>

            </div>

        </div>

    </div>


    <!-- ========================================
         ACTIVIDAD RECIENTE
    ========================================= -->

    <h2 class="titulo-seccion">
        Actividad reciente
    </h2>


    <div class="actividad">

        <h4>
            Últimas operaciones
        </h4>

        <hr />

        <div class="sin-actividad">

            <div style="font-size:40px;">
                📋
            </div>

            <p class="mt-3">
                Todavía no existen operaciones recientes.
            </p>

        </div>

    </div>

</div>