@{
    ViewData["Title"] = "Administrador - FLOMAR";
}

<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
    }

    body {
        background-color: #1a1a1a;
        color: white;
        font-family: Arial, sans-serif;
    }


    /* ENCABEZADO */

    .encabezado {
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 35px;
        background-color: #222222;
        border-bottom: 1px solid #444444;
    }

    .logo {
        color: #d4af37;
        font-size: 26px;
        font-weight: bold;
    }

    .cerrar-sesion {
        display: inline-block;
        background-color: #d4af37;
        color: #1a1a1a;
        border: none;
        border-radius: 5px;
        padding: 9px 18px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
    }

    .cerrar-sesion:hover {
        background-color: #e6c65c;
        color: #1a1a1a;
    }


    /* CONTENIDO */

    .contenido {
        min-height: calc(100vh - 70px);
        padding: 35px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }


    /* TITULO */

    .titulo {
        margin: 5px 0 25px 0;
        color: #d4af37;
        font-size: 28px;
        text-align: center;
    }


    /* TARJETAS */

    .tarjetas {
        width: 900px;
        max-width: 100%;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }


    /* TARJETA */

    .tarjeta {
        height: 160px;
        background-color: #2b2b2b;
        border: 1px solid #444444;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        transition: 0.2s;
    }

    .tarjeta:hover {
        border-color: #d4af37;
        transform: translateY(-2px);
    }


    /* ICONO */

    .icono {
        font-size: 30px;
        margin-bottom: 5px;
    }


    /* TITULO TARJETA */

    .tarjeta h3 {
        color: #d4af37;
        font-size: 17px;
        margin: 4px 0;
    }


    /* DESCRIPCION */

    .tarjeta p {
        color: #cccccc;
        font-size: 13px;
        margin: 4px 0 10px 0;
    }


    /* BOTON */

    .boton {
        display: inline-block;
        background-color: #d4af37;
        color: #1a1a1a;
        border: none;
        border-radius: 5px;
        padding: 7px 18px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
    }

    .boton:hover {
        background-color: #e6c65c;
        color: #1a1a1a;
    }


    /* BOTON DESHABILITADO */

    .boton-deshabilitado {
        display: inline-block;
        background-color: #555555;
        color: #aaaaaa;
        border-radius: 5px;
        padding: 7px 18px;
        font-weight: bold;
        cursor: not-allowed;
    }


    /* RESPONSIVE */

    @@media (max-width: 900px) {
        .tarjetas {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .tarjetas {
            grid-template-columns: 1fr;
        }
    }

</style>


<!-- ENCABEZADO -->

<header class="encabezado">

    <div class="logo">
        FLOMAR
    </div>

    <a asp-controller="Login"
       asp-action="Logout"
       class="cerrar-sesion">
        Cerrar sesión
    </a>

</header>


<!-- CONTENIDO -->

<main class="contenido">

    <h1 class="titulo">
        Panel de Administrador
    </h1>


    <div class="tarjetas">


        <!-- REPUESTOS -->

        <div class="tarjeta">

            <div class="icono">
                🔧
            </div>

            <h3>
                Repuestos
            </h3>

            <p>
                Gestión de repuestos
            </p>

            <a asp-controller="Repuestos"
               asp-action="Index"
               class="boton">

                Repuestos

            </a>

        </div>


        <!-- USUARIOS -->

        <div class="tarjeta">

            <div class="icono">
                👤
            </div>

            <h3>
                Usuarios
            </h3>

            <p>
                Gestión de usuarios
            </p>

            <a asp-controller="Usuarios"
               asp-action="Index"
               class="boton">

                Usuarios

            </a>

        </div>


        <!-- INVENTARIO -->

        <div class="tarjeta">

            <div class="icono">
                📦
            </div>

            <h3>
                Inventario
            </h3>

            <p>
                Control del inventario
            </p>

            <a asp-controller="MovimientoInventario"
               asp-action="Index"
               class="boton">

                Inventario

            </a>

        </div>


        <!-- VENTAS -->

        <div class="tarjeta">

            <div class="icono">
                🛒
            </div>

            <h3>
                Ventas
            </h3>

            <p>
                Gestión de ventas
            </p>

            <a asp-controller="Home"
               asp-action="Vendedor"
               class="boton">

                Ventas

            </a>

        </div>


        <!-- REPORTES -->

        <div class="tarjeta">

            <div class="icono">
                📊
            </div>

            <h3>
                Reportes
            </h3>

            <p>
                Reportes del sistema
            </p>

            <span class="boton-deshabilitado">
                Próximamente
            </span>

        </div>


        <div class="tarjeta">

            <div class="icono">
                🚚
            </div>

            <h3>
                Mercadería
            </h3>

            <p>
                Ingreso y compra de mercadería
            </p>

            <a asp-controller="Compras"
               asp-action="Index"
               class="boton">
                Mercadería
            </a>

        </div>

    </div>

</main>