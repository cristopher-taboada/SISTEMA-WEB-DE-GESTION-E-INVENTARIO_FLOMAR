@model FLOMAR.Models.CompraCreateViewModel

@{
    ViewData["Title"] = "Nueva Compra";
}

<style>
    .crear-page {
        min-height: 100vh;
        background: #181818;
        padding: 35px;
        color: white;
    }

    .crear-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .crear-header {
        margin-bottom: 25px;
    }

        .crear-header h1 {
            margin: 0 0 8px 0;
            font-size: 28px;
            font-weight: bold;
        }

            .crear-header h1 span {
                color: #d4af37;
            }

        .crear-header p {
            color: #aaa;
            margin: 0;
        }

    .crear-card {
        background: #202020;
        border: 1px solid #3b3b3b;
        border-radius: 10px;
        padding: 30px;
    }

    .crear-info {
        background: #292929;
        border-left: 4px solid #d4af37;
        padding: 13px 15px;
        border-radius: 4px;
        margin-bottom: 25px;
        color: #bbb;
    }

        .crear-info strong {
            color: #d4af37;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #eee;
        }

    .form-control-flomar {
        width: 100%;
        background: #181818;
        color: white;
        border: 1px solid #555;
        border-radius: 6px;
        padding: 12px 14px;
        box-sizing: border-box;
        outline: none;
    }

        .form-control-flomar:focus {
            border-color: #d4af37;
        }

        .form-control-flomar::placeholder {
            color: #777;
        }

    .validation-message {
        display: block;
        color: #ff6565;
        font-size: 13px;
        margin-top: 5px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 15px;
    }

    .btn-guardar {
        background: #d4af37;
        color: #111;
        border: none;
        padding: 12px 24px;
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-guardar:hover {
            background: #e5c34b;
        }

    .btn-cancelar {
        background: transparent;
        color: #ddd;
        border: 1px solid #555;
        padding: 11px 24px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-cancelar:hover {
            color: #d4af37;
            border-color: #d4af37;
        }

    @@media (max-width: 700px) {
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="crear-page">

    <div class="crear-container">

        <div class="crear-header">
            <h1>
                Nueva <span>Compra</span>
            </h1>

            <p>
                Registra un nuevo ingreso de mercadería en FLOMAR.
            </p>
        </div>


        <div class="crear-card">

            <div class="crear-info">
                Complete los datos de la <strong>nueva compra</strong>.
            </div>


            <form asp-controller="Compras"
                  asp-action="Create"
                  method="post">

                <!-- NRO. COMPRA Y FECHA -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="numero_compra">
                            Nro. Compra
                        </label>

                        <input asp-for="numero_compra"
                               class="form-control-flomar"
                               placeholder="Ej: CMP-2026-004" />

                        <span asp-validation-for="numero_compra"
                              class="validation-message">
                        </span>

                    </div>

                    <div class="form-group">

                        <label asp-for="fecha_ingreso">
                            Fecha de Ingreso
                        </label>

                        <input asp-for="fecha_ingreso"
                               type="datetime-local"
                               class="form-control-flomar" />

                        <span asp-validation-for="fecha_ingreso"
                              class="validation-message">
                        </span>

                    </div>

                </div>


                <!-- PROVEEDOR -->
                <div class="form-group">

                    <label asp-for="id_proveedor">
                        ID Proveedor
                    </label>

                    <input asp-for="id_proveedor"
                           type="number"
                           min="1"
                           class="form-control-flomar"
                           placeholder="Ej: 1" />

                    <span asp-validation-for="id_proveedor"
                          class="validation-message">
                    </span>

                </div>


                <!-- OBSERVACIONES -->
                <div class="form-group">

                    <label asp-for="observaciones">
                        Observaciones
                    </label>

                    <input asp-for="observaciones"
                           class="form-control-flomar"
                           placeholder="Ej: Pedido urgente de frenos" />

                    <span asp-validation-for="observaciones"
                          class="validation-message">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="form-actions">

                    <button type="submit"
                            class="btn-guardar">
                        + Guardar Compra
                    </button>

                    <a asp-controller="Compras"
                       asp-action="Index"
                       class="btn-cancelar">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
