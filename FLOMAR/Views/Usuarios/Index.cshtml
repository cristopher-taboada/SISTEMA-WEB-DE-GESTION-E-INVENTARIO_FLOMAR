@{
    Layout = null;
    ViewData["Title"] = "Usuarios - FLOMAR";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>FLOMAR - Usuarios</title>

    <style>

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
            }

            body {
                background-color: #1a1a1a;
                color: white;
                font-family: Arial, sans-serif;
            }


            /* ENCABEZADO */

            .encabezado {
                height: 65px;
                background-color: #222222;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                border-bottom: 1px solid #444444;
            }


            .logo {
                color: #d4af37;
                font-size: 25px;
                font-weight: bold;
            }


            .usuario {
                color: #cccccc;
                margin-right: 20px;
            }


            .cerrar {
                background-color: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                border-radius: 5px;
                padding: 8px 15px;
                cursor: pointer;
                font-weight: bold;
            }


                .cerrar:hover {
                    background-color: #d4af37;
                    color: #1a1a1a;
                }


            /* CONTENIDO */

            .contenido {
                padding: 35px;
            }


            .titulo {
                color: #d4af37;
                margin: 0 0 8px 0;
                font-size: 28px;
            }


            .descripcion {
                color: #bbbbbb;
                margin-bottom: 25px;
            }


            /* CONTENEDOR DE LA TABLA */

            .tabla-contenedor {
                background-color: #2b2b2b;
                border: 1px solid #444444;
                border-radius: 10px;
                padding: 25px;
            }


            /* PARTE SUPERIOR */

            .tabla-superior {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }


            .subtitulo {
                color: white;
                margin: 0;
                font-size: 20px;
            }


            .nuevo {
                background-color: #d4af37;
                color: #1a1a1a;
                border: none;
                border-radius: 5px;
                padding: 10px 18px;
                font-weight: bold;
                cursor: pointer;
            }


                .nuevo:hover {
                    background-color: #e6c65c;
                }


            /* TABLA */

            table {
                width: 100%;
                border-collapse: collapse;
            }


            th {
                color: #d4af37;
                text-align: left;
                padding: 14px;
                border-bottom: 1px solid #555555;
                font-size: 14px;
            }


            td {
                padding: 14px;
                border-bottom: 1px solid #444444;
                color: #dddddd;
            }


            tr:hover {
                background-color: #333333;
            }


            /* ESTADO */

            .estado {
                display: inline-block;
                padding: 5px 10px;
                border-radius: 15px;
                font-size: 12px;
                font-weight: bold;
            }


            .activo {
                background-color: #234d32;
                color: #7ee29b;
            }


            .inactivo {
                background-color: #4d2323;
                color: #ff8a8a;
            }


            /* BOTONES */

            .editar {
                background-color: #d4af37;
                color: #1a1a1a;
                border: none;
                border-radius: 4px;
                padding: 7px 12px;
                font-weight: bold;
                cursor: pointer;
                margin-right: 5px;
            }


                .editar:hover {
                    background-color: #e6c65c;
                }


            .desactivar {
                background-color: #444444;
                color: #ffffff;
                border: 1px solid #666666;
                border-radius: 4px;
                padding: 7px 12px;
                font-weight: bold;
                cursor: pointer;
            }


                .desactivar:hover {
                    background-color: #555555;
                }

    </style>

</head>


<body>


    <!-- ENCABEZADO -->

    <header class="encabezado">

        <div class="logo">
            FLOMAR
        </div>


        <div>

            <span class="usuario">
                Bienvenido, Javier Flores (Admin)
            </span>

            <button class="cerrar">
                Cerrar sesión
            </button>

        </div>

    </header>


    <!-- CONTENIDO -->

    <main class="contenido">


        <h1 class="titulo">
            Gestión de Usuarios
        </h1>


        <p class="descripcion">
            Administración de usuarios y roles del sistema FLOMAR.
        </p>


        <!-- TABLA -->

        <section class="tabla-contenedor">


            <div class="tabla-superior">

                <h2 class="subtitulo">
                    Usuarios del sistema
                </h2>


                <button class="nuevo">
                    + Nuevo usuario
                </button>

            </div>


            <table>

                <thead>

                    <tr>

                        <th>
                            Usuario
                        </th>

                        <th>
                            Nombre
                        </th>

                        <th>
                            Rol
                        </th>

                        <th>
                            Estado
                        </th>

                        <th>
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>


                    <!-- ADMINISTRADOR -->

                    <tr>

                        <td>
                            admin
                        </td>

                        <td>
                            Javier Flores Martinez
                        </td>

                        <td>
                            Administrador
                        </td>

                        <td>
                            <span class="estado activo">
                                Activo
                            </span>
                        </td>

                        <td>

                            <button class="editar">
                                Editar
                            </button>

                            <button class="desactivar">
                                Desactivar
                            </button>

                        </td>

                    </tr>


                    <!-- VENDEDOR 1 -->

                    <tr>

                        <td>
                            vendedor1
                        </td>

                        <td>
                            Brayan Flores Marzana
                        </td>

                        <td>
                            Vendedor
                        </td>

                        <td>
                            <span class="estado activo">
                                Activo
                            </span>
                        </td>

                        <td>

                            <button class="editar">
                                Editar
                            </button>

                            <button class="desactivar">
                                Desactivar
                            </button>

                        </td>

                    </tr>


                    <!-- VENDEDOR 2 -->

                    <tr>

                        <td>
                            vendedor2
                        </td>

                        <td>
                            Nestor Maraza Acarapi
                        </td>

                        <td>
                            Vendedor
                        </td>

                        <td>
                            <span class="estado activo">
                                Activo
                            </span>
                        </td>

                        <td>

                            <button class="editar">
                                Editar
                            </button>

                            <button class="desactivar">
                                Desactivar
                            </button>

                        </td>

                    </tr>


                </tbody>

            </table>


        </section>


    </main>


</body>

</html>