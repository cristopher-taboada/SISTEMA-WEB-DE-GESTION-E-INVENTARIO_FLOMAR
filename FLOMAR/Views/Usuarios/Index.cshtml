@model IEnumerable<FLOMAR.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<style>
    .usuarios-container {
        padding: 30px;
        color: #f5f5f5;
    }

    /* ==============================
           BARRA SUPERIOR 
        ============================== */
    .top-navbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #333;
        padding-bottom: 15px;
        margin-bottom: 25px;
    }

    .top-navbar h3 {
        color: #d4af37;
        margin: 0;
        font-weight: bold;
    }

    .btn-volver {
        color: #d4af37;
        border: 1px solid #d4af37;
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 4px;
        font-size: 14px;
        font-weight: bold;
        transition: all 0.25s ease;
    }

    .btn-volver:hover {
        background: #d4af37;
        color: #111;
    }

    /* ==============================
           ENCABEZADO
        ============================== */
    .encabezado-usuarios {
        margin-bottom: 25px;
    }

    .usuarios-titulo {
        color: #d4af37;
        font-weight: bold;
        margin: 0 0 5px 0;
    }

    .usuarios-subtitulo {
        color: #f5f5f5;
        margin: 0;
    }

    /* ==============================
           CONTENEDOR TABLA
        ============================== */
    .tabla-contenedor {
        background-color: #202020;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 25px;
        overflow-x: auto;
    }

    .tabla-superior {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .subtitulo {
        color: white;
        margin: 0;
        font-size: 20px;
    }

    .contador {
        background-color: #333;
        color: #d4af37;
        padding: 8px 14px;
        border-radius: 5px;
        font-weight: bold;
    }

    /* ==============================
           TABLA
        ============================== */
    .tabla-usuarios {
        width: 100%;
        border-collapse: collapse;
    }

    .tabla-usuarios th {
        color: #d4af37;
        text-align: left;
        padding: 12px;
        border-bottom: 2px solid #d4af37;
        background-color: #111;
        font-size: 14px;
    }

    .tabla-usuarios td {
        padding: 14px;
        border-bottom: 1px solid #444;
        color: #dddddd;
    }

    .tabla-usuarios tr:hover {
        background-color: #292929;
    }

    /* ESTADOS */
    .estado {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: bold;
    }

    .activo {
        background-color: rgba(40, 167, 69, 0.2);
        color: #59d879;
    }

    .inactivo {
        background-color: rgba(220, 53, 69, 0.2);
        color: #ff5252;
    }

    .otro-estado {
        background-color: #444;
        color: #ddd;
    }

    .rol {
        font-weight: bold;
    }

    .sin-usuarios {
        text-align: center;
        color: #aaa;
        padding: 30px;
    }

    @@media (max-width: 768px) {
        .usuarios-container {
            padding: 20px 10px;
        }
        .top-navbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }
</style>

<div class="usuarios-container">

    <!-- BARRA SUPERIOR CON BOTON -->
    <div class="top-navbar">
        <h3>FLOMAR</h3>
        <div style="display: flex; align-items: center; gap: 20px;">
            <span style="color: #ddd; font-size: 14px;">Gestión de Usuarios</span>
            <a href="/Home/Admin" class="btn-volver">Volver al panel</a>
        </div>
    </div>

    <!-- ENCABEZADO -->
    <div class="encabezado-usuarios">
        <h2 class="usuarios-titulo">
            Gestión de Usuarios
        </h2>
        <p class="usuarios-subtitulo">
            Usuarios registrados actualmente en el sistema FLOMAR.
        </p>
    </div>

    <!-- CONTENEDOR TABLA -->
    <div class="tabla-contenedor">
        <div class="tabla-superior">
            <h2 class="subtitulo">
                Usuarios del sistema
            </h2>
            <span class="contador">
                Total: @Model.Count()
            </span>
        </div>

        <div style="overflow-x: auto;">
            <table class="tabla-usuarios">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Nombre completo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Fecha creación</th>
                        <th>Último acceso</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.id_usuario</td>
                                <td>@usuario.Nombre_Usuario</td>
                                <td>@usuario.nombre_completo</td>
                                <td>
                                    <span class="rol">
                                        @if (usuario.id_rol == 1)
                                        {
                                            <span>Administrador</span>
                                        }
                                        else if (usuario.id_rol == 2)
                                        {
                                            <span>Vendedor</span>
                                        }
                                        else
                                        {
                                            <span>Rol @usuario.id_rol</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @if (usuario.id_estado_usuario == 1)
                                    {
                                        <span class="estado activo">Activo</span>
                                    }
                                    else if (usuario.id_estado_usuario == 2)
                                    {
                                        <span class="estado inactivo">Inactivo</span>
                                    }
                                    else
                                    {
                                        <span class="estado otro-estado">Estado @usuario.id_estado_usuario</span>
                                    }
                                </td>
                                <td>@usuario.fecha_creacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (usuario.ultimo_acceso.HasValue)
                                    {
                                        @usuario.ultimo_acceso.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>Sin acceso registrado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="sin-usuarios">
                                No existen usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>