@model IEnumerable<FLOMAR.Models.Usuario>

@{
    Layout = null;
    ViewData["Title"] = "Usuarios - FLOMAR";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>FLOMAR - Usuarios</title>

    <style>

            * {
                box-sizing: border-box;
            }

            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
            }

            body {
                background-color: #1a1a1a;
                color: white;
                font-family: Arial, sans-serif;
            }


            /* ENCABEZADO */

            .encabezado {
                height: 65px;
                background-color: #222222;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                border-bottom: 1px solid #444444;
            }

            .logo {
                color: #d4af37;
                font-size: 25px;
                font-weight: bold;
            }

            .usuario {
                color: #cccccc;
                margin-right: 20px;
            }

            .cerrar {
                background-color: transparent;
                color: #d4af37;
                border: 1px solid #d4af37;
                border-radius: 5px;
                padding: 8px 15px;
                cursor: pointer;
                font-weight: bold;
            }

                .cerrar:hover {
                    background-color: #d4af37;
                    color: #1a1a1a;
                }


            /* CONTENIDO */

            .contenido {
                padding: 35px;
            }

            .titulo {
                color: #d4af37;
                margin: 0 0 8px 0;
                font-size: 28px;
            }

            .descripcion {
                color: #bbbbbb;
                margin-bottom: 25px;
            }


            /* CONTENEDOR TABLA */

            .tabla-contenedor {
                background-color: #2b2b2b;
                border: 1px solid #444444;
                border-radius: 10px;
                padding: 25px;
                overflow-x: auto;
            }


            /* PARTE SUPERIOR */

            .tabla-superior {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
            }

            .subtitulo {
                color: white;
                margin: 0;
                font-size: 20px;
            }

            .contador {
                background-color: #333333;
                color: #d4af37;
                padding: 8px 14px;
                border-radius: 5px;
                font-weight: bold;
            }


            /* TABLA */

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                color: #d4af37;
                text-align: left;
                padding: 14px;
                border-bottom: 1px solid #555555;
                font-size: 14px;
            }

            td {
                padding: 14px;
                border-bottom: 1px solid #444444;
                color: #dddddd;
            }

            tr:hover {
                background-color: #333333;
            }


            /* ESTADOS */

            .estado {
                display: inline-block;
                padding: 5px 10px;
                border-radius: 15px;
                font-size: 12px;
                font-weight: bold;
            }

            .activo {
                background-color: #234d32;
                color: #7ee29b;
            }

            .inactivo {
                background-color: #4d2323;
                color: #ff8a8a;
            }

            .otro-estado {
                background-color: #444444;
                color: #dddddd;
            }


            /* ROLES */

            .rol {
                font-weight: bold;
            }


            /* SIN USUARIOS */

            .sin-usuarios {
                text-align: center;
                color: #aaaaaa;
                padding: 30px;
            }

    </style>

</head>


<body>


    <!-- ENCABEZADO -->

    <header class="encabezado">

        <div class="logo">
            FLOMAR
        </div>

        <div>

            <span class="usuario">
                Gestión de Usuarios
            </span>

            <a asp-controller="Home"
               asp-action="Admin"
               class="cerrar"
               style="text-decoration:none;">
                Volver al panel
            </a>

        </div>

    </header>


    <!-- CONTENIDO -->

    <main class="contenido">


        <h1 class="titulo">
            Gestión de Usuarios
        </h1>


        <p class="descripcion">
            Usuarios registrados actualmente en el sistema FLOMAR.
        </p>


        <section class="tabla-contenedor">


            <div class="tabla-superior">

                <h2 class="subtitulo">
                    Usuarios del sistema
                </h2>

                <span class="contador">
                    Total: @Model.Count()
                </span>

            </div>


            <table>

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Usuario</th>

                        <th>Nombre completo</th>

                        <th>Rol</th>

                        <th>Estado</th>

                        <th>Fecha creación</th>

                        <th>Último acceso</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td>
                                    @usuario.id_usuario
                                </td>


                                <td>
                                    @usuario.Nombre_Usuario
                                </td>


                                <td>
                                    @usuario.nombre_completo
                                </td>


                                <td>

                                    <span class="rol">

                                        @if (usuario.id_rol == 1)
                                        {
                                            <span>Administrador</span>
                                        }
                                        else if (usuario.id_rol == 2)
                                        {
                                            <span>Vendedor</span>
                                        }
                                        else
                                        {
                                            <span>Rol @usuario.id_rol</span>
                                        }

                                    </span>

                                </td>


                                <td>

                                    @if (usuario.id_estado_usuario == 1)
                                    {
                                        <span class="estado activo">
                                            Activo
                                        </span>
                                    }
                                    else if (usuario.id_estado_usuario == 2)
                                    {
                                        <span class="estado inactivo">
                                            Inactivo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="estado otro-estado">
                                            Estado @usuario.id_estado_usuario
                                        </span>
                                    }

                                </td>


                                <td>
                                    @usuario.fecha_creacion.ToString("dd/MM/yyyy HH:mm")
                                </td>


                                <td>

                                    @if (usuario.ultimo_acceso.HasValue)
                                    {
                                        @usuario.ultimo_acceso.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span>
                                            Sin acceso registrado
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="sin-usuarios">

                                No existen usuarios registrados.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>


        </section>


    </main>


</body>

</html>